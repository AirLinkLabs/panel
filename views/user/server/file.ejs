<%- include('../../layouts/user', { title: t('files') }) %>
<style>
  .al-editor-shell { min-height: calc(100dvh - 15rem); }
  .al-editor-toolbar { gap: 0.75rem; }
  .al-editor-path {
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.35;
  }
  .al-editor-status {
    gap: 0.5rem 1rem;
    scrollbar-width: thin;
  }
  .al-editor-status button,
  .al-editor-status span[data-kbd] {
    min-height: 1.5rem;
  }
  @media (max-width: 1023px) {
    .al-editor-shell { min-height: 60dvh; }
  }
</style>

<%
const fileExtension = (file.extension || '').toString().toLowerCase();
const languageMap = {
  js: 'javascript', mjs: 'javascript', cjs: 'javascript', jsx: 'javascript',
  json: 'json', html: 'html', htm: 'html', css: 'css',
  ts: 'typescript', tsx: 'typescript', md: 'markdown', markdown: 'markdown',
  txt: 'plaintext', py: 'python', sh: 'shell', bash: 'shell', zsh: 'shell',
  go: 'go', php: 'php', sql: 'sql', c: 'c', h: 'c', cpp: 'cpp',
  cs: 'csharp', java: 'java', rb: 'ruby', rs: 'rust', yml: 'yaml',
  yaml: 'yaml', xml: 'xml', toml: 'ini', ini: 'ini', cfg: 'ini',
  conf: 'ini', properties: 'ini', env: 'plaintext', dockerfile: 'dockerfile',
  gradle: 'groovy', kt: 'kotlin', swift: 'swift', lua: 'lua', r: 'r',
  dart: 'dart', ex: 'elixir', exs: 'elixir', hs: 'haskell', scala: 'scala',
  vue: 'html', svelte: 'html',
};
const language = languageMap[fileExtension] || 'plaintext';
const _initContent = file.content || '';
const fileContentTooLarge = _initContent.length > 1048576;
const fileContentInvalidUtf8 = /[\uFFFD]/.test(_initContent);
const fileContentSkipped = fileContentTooLarge || fileContentInvalidUtf8;
const filePath = file.path || '';
const serverUUID = server.UUID;
%>

<div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-0 pb-12 lg:pb-12">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + serverUUID },
    { label: t('files'), url: '/server/' + serverUUID + '/files' },
    { label: file.name }
  ] }) %>

  <div class="px-8 pt-4">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <h1 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= t('files') %></h1>
        <div class="flex items-center gap-3 mt-1.5 flex-wrap">
          <div class="flex items-center gap-1.5">
            <%- icon('box', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] truncate max-w-[140px]" style="color:var(--theme-text-muted)"><%= server.image?.name %></span>
          </div>
          <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
          <div class="flex items-center gap-1.5">
            <%- icon('server', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] truncate max-w-[100px]" style="color:var(--theme-text-muted)"><%= server.node?.name %></span>
          </div>
          <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
          <div class="flex items-center gap-1.5">
            <%- icon('hash', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] font-mono" style="color:var(--theme-text-muted)"><%= serverUUID.split('-')[0] %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="file-editor-root" data-config="<%- JSON.stringify({
    serverUUID: serverUUID,
    filePath: filePath,
    language: language,
    content: fileContentSkipped ? '' : (file.content || ''),
    tooLarge: fileContentTooLarge,
    invalidUtf8: fileContentInvalidUtf8,
    skipped: fileContentSkipped,
    fileExtension: fileExtension,
    saveUrl: '/server/' + serverUUID + '/files/' + encodeURIComponent(filePath),
  }).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>">

    <div class="flex flex-col lg:flex-row px-8 mt-8">
      <div class="al-ui-surface overflow-hidden rounded-xl w-full">
        <div class="p-5">
          <div class="al-editor-toolbar flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
            <h2 class="al-editor-path text-sm font-medium min-w-0" style="color:var(--theme-text-strong)">
              <a class="hover:text-[var(--theme-text-strong)] transition" href="/server/<%= serverUUID %>/files" style="color:var(--theme-text-muted)">/home/container/</a>
              <%
                if (filePath) {
                  const parts = filePath.split('/');
                  let curBuild = '';
                  parts.forEach(function(part, index) {
                    curBuild += part;
                    if (index < parts.length - 1) { %>
                      <a href="/server/<%= serverUUID %>/files?path=<%= curBuild %>" class="hover:text-[var(--theme-text-strong)] transition" style="color:var(--theme-text-muted)"><%= part %></a><span style="color:var(--theme-text-muted)">/</span>
                    <% curBuild += '/';
                    } else { %>
                      <span style="color:var(--theme-text-strong)"><%= part %></span>
                    <% }
                  });
                }
              %>
            </h2>
            <div class="flex shrink-0">
              <button id="saveBtn" class="al-ui-button-primary min-w-24" type="button">
                <%- icon('save', { class: 'h-4 w-4 mr-1.5', strokeWidth: 2 }) %>
                <%= t('saveBtn') %>
              </button>
            </div>
          </div>
          <div class="border rounded-xl overflow-hidden" style="border-color:var(--theme-border)" id="editor-container-wrapper">
            <div class="al-editor-shell" id="editor-container"></div>
            <div class="al-editor-status flex flex-col xl:flex-row xl:justify-between xl:items-center px-3 py-2 border-t text-xs font-mono overflow-x-auto" style="background:var(--theme-bg-secondary);border-top-color:var(--theme-border);color:var(--theme-text-muted);">
              <div class="flex items-center gap-3 whitespace-nowrap">
                <div id="editor-status">Line: 1, Column: 1</div>
                <div id="file-info" class="px-2 py-0.5 rounded" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"><%= t('loadingEllipsis') %></div>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center">
                  <span class="opacity-75 mr-1.5"><%= t('wordWrap') %>:</span>
                  <button type="button" id="toggle-wordwrap" class="px-1.5 py-0.5 rounded transition-colors" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"><%= t('offLabel') %></button>
                </div>
                <div class="flex items-center">
                  <span class="opacity-75 mr-1.5"><%= t('minimap') %>:</span>
                  <button type="button" id="toggle-minimap" class="px-1.5 py-0.5 rounded transition-colors" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"><%= t('offLabel') %></button>
                </div>
                <div class="flex items-center">
                  <span class="opacity-75 mr-1.5"><%= t('theme') %>:</span>
                  <button type="button" id="toggle-theme" class="px-1.5 py-0.5 rounded transition-colors" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"><%= t('autoLabel') %></button>
                </div>
                <div class="flex items-center">
                  <span class="opacity-75 mr-1.5"><%= t('saveBtn') %>:</span>
                  <span data-kbd class="px-1.5 py-0.5 rounded" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted)"><%= t('ctrlS') %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/monaco/vs/loader.js') %>"></script>
<script type="application/json" id="editor-file-data"><%- JSON.stringify({ content: file.content || '', tooLarge: fileContentTooLarge, invalidUtf8: fileContentInvalidUtf8 }).replace(/<\//g, '<\\/').replace(/&/g, '&amp;').replace(/"/g, '&quot;') %></script>
<script type="module" nonce="<%- nonce %>">
  import { mount } from '<%= assetUrl('/javascript/islands/file-editor.js') %>';
  const root = document.getElementById('file-editor-root');
  if (root) {
    const { teardown } = await mount(root, JSON.parse(root.dataset.config));
    window.addEventListener('beforeunload', () => {
      if (teardown) teardown();
    }, { once: true });
  }
</script>

<%- include('../../layouts/user-footer') %>
