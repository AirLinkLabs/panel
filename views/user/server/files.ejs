<%- include('../../layouts/user', { title: t('files') }) %>
<style>
  .al-file-panel { contain: layout paint; }
  .al-file-row:hover .al-file-icon { transform: translateY(-1px); }
  .al-file-row.is-selected { background: var(--theme-bg-secondary, rgb(245 245 245)); }
  .dark .al-file-row.is-selected { background: var(--theme-bg-hover, rgb(255 255 255 / 0.04)); }
  .al-file-icon { transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), color 150ms ease; }
</style>

<%
function getFileIcon(category) {
  const iconNames = {
    'Configuration Files': 'file-code',
    'Documents': 'file-text',
    'Folder': 'folder',
    'Images': 'image',
    'No Category': 'file',
  };
  const name = iconNames[category] || 'file';
  return `<span class="al-file-icon size-6">${icon(name, { class: 'size-6' })}</span>`;
}

function isImageFile(filename) {
  const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg', 'webp', 'tiff'];
  const extension = filename.split('.').pop().toLowerCase();
  return imageExtensions.includes(extension);
}

function escAttr(val) {
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
%>

<div id="page-content" class="flex-1 min-w-0 overflow-y-auto pt-0 pb-12 lg:pb-12">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('dashboard'), url: '/' },
    { label: server.name, url: '/server/' + server.UUID },
    { label: t('files') }
  ] }) %>

  <!-- Page Header -->
  <div class="px-6 sm:px-8 pt-3 pb-2 sm:pb-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="flex-1 min-w-0">
        <h1 class="text-lg font-semibold" style="color:var(--theme-text-strong)"><%= t('files') %></h1>
        <div class="flex items-center gap-3 mt-1.5 flex-wrap">
          <div class="flex items-center gap-1.5">
            <%- icon('box', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] truncate max-w-[140px]" style="color:var(--theme-text-muted)"><%= server.image?.name %></span>
          </div>
          <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
          <div class="flex items-center gap-1.5">
            <%- icon('server', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] truncate max-w-[100px]" style="color:var(--theme-text-muted)"><%= server.node?.name %></span>
          </div>
          <span class="text-[11px]" style="color:var(--theme-text-muted)">·</span>
          <div class="flex items-center gap-1.5">
            <%- icon('hash', { class: 'h-3 w-3 shrink-0' }) %>
            <span class="text-[11px] font-mono" style="color:var(--theme-text-muted)"><%= server.UUID.split('-')[0] %></span>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap gap-1.5 shrink-0">
        <button id="createFile" type="button" class="al-btn-secondary">
          <%- icon('file-plus', { class: 'size-3.5 inline-flex mr-1' }) %>
          <%= t('newFile') %>
        </button>
        <button id="createFolder" type="button" class="al-btn-secondary">
          <%- icon('folder-plus', { class: 'size-3.5 inline-flex mr-1' }) %>
          <%= t('newFolder') %>
        </button>
        <button id="uploadFile" type="button" class="al-btn-secondary">
          <%- icon('upload', { class: 'size-3.5 inline-flex mr-1' }) %>
          <%= t('uploadFile') %>
        </button>
        <button id="pullFile" type="button" class="al-btn-secondary">
          <%- icon('download', { class: 'size-3.5 inline-flex mr-1' }) %>
          <%= t('pullFromUrl') %>
        </button>
        <button id="refreshFiles" type="button" class="al-btn-secondary">
          <%- icon('refresh-cw', { class: 'size-3.5 inline-flex mr-1' }) %>
          <%= t('refresh') %>
        </button>
      </div>
    </div>
  </div>

  <!-- File Table -->
  <div class="px-6 sm:px-8 mt-6">
    <div class="al-file-panel overflow-x-auto rounded-xl" style="border:1px solid var(--theme-border);">
      <!-- Breadcrumb path -->
      <div class="px-3 py-2 flex items-center overflow-hidden">
        <nav class="flex items-center gap-0 text-[11px] min-w-0 overflow-hidden">
          <a class="hover:text-[var(--theme-text)] transition shrink-0" href="./files" style="color:var(--theme-text-muted)">/home/container/</a>
          <%
            const currentPath = (typeof filesCurrentPath !== 'undefined' && filesCurrentPath) ? filesCurrentPath : '';
            if (currentPath) {
              const parts = currentPath.split('/').filter(Boolean);
              let buildPath = '';
              parts.forEach((part, index) => {
                buildPath += part;
                if (index < parts.length - 1) { %>
                  <a href="./files?path=<%= buildPath %>" class="hover:text-[var(--theme-text)] transition" style="color:var(--theme-text-muted)"><%= part %></a><span class="mx-0.5" style="color:var(--theme-text-muted)">/</span>
                <% buildPath += '/';
                } else { %>
                  <span class="font-medium" style="color:var(--theme-text-strong)"><%= part %></span>
                <% }
              });
            }
          %>
        </nav>
      </div>
      <!-- Search/filter -->
      <div class="px-3 py-1.5 flex items-center gap-2" style="border-bottom:1px solid var(--theme-border);">
        <%- icon('search', { size: 12, class: 'shrink-0' }) %>
        <input id="fileSearchInput" type="text" placeholder="<%= t('filterFiles') %>"
          class="flex-1 bg-transparent text-[13px] focus:outline-none"
          style="color:var(--theme-text-strong);" autocomplete="off" spellcheck="false"
          aria-label="<%= t('filterFiles') %>">
        <button type="button" id="clearFileSearch" class="hidden p-0.5 rounded transition" aria-label="<%= t('clearSearchFilter') %>" style="color:var(--theme-text-muted);">
          <%- icon('x', { size: 10 }) %>
        </button>
      </div>
      <table class="min-w-full al-table" style="background:var(--theme-bg-card);">
        <thead class="al-table-head">
          <tr>
            <th class="px-3 py-2 text-left w-10" scope="col">
              <input type="checkbox" id="selectAll" class="form-checkbox h-3.5 w-3.5 rounded transition file-checkbox" aria-label="<%= t('selectFileAll') %>">
            </th>
            <th class="al-table-th px-3 py-2 text-left" scope="col"><%= t('name') %></th>
            <th class="al-table-th px-3 py-2 text-left w-24" scope="col"><%= t('size') %></th>
            <th class="al-table-th px-3 py-2 text-left w-32 hidden md:table-cell" scope="col"><%= t('modified') %></th>
          </tr>
        </thead>
        <tbody id="fileTableBody">
          <%- include('./files-rows') %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Floating Action Bar -->
  <div id="floatingActionBar" class="fixed bottom-14 lg:bottom-0 right-0 z-40 py-3.5 px-6 flex items-center justify-between gap-4 left-0 lg:left-60 translate-y-full transition-transform duration-300 ease-out shadow-lg" style="background:var(--theme-bg-card); border-top:1px solid var(--theme-border);">
    <div class="flex items-center gap-2.5">
      <%- icon('check-square', { size: 15, class: 'shrink-0' }) %>
      <span id="selectedFilesCount" class="text-sm font-medium" style="color:var(--theme-text-strong)"></span>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" id="massRenameBtn" class="al-btn-secondary inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium">
        <%- icon('pencil', { size: 13, class: 'shrink-0' }) %>
        <%= t('rename') %>
      </button>
      <button type="button" id="massArchiveBtn" class="al-btn-primary inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium">
        <%- icon('file-archive', { size: 13, class: 'shrink-0' }) %>
        <%= t('archive') %>
      </button>
      <button type="button" id="massDeleteBtn" class="al-btn-danger inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium">
        <%- icon('trash-2', { size: 13, class: 'shrink-0' }) %>
        <%= t('delete') %>
      </button>
      <button type="button" id="dismissSelectionBtn" class="inline-flex items-center justify-center w-7 h-7 rounded-lg transition ml-1" style="color:var(--theme-text-muted);" title="<%= t('deselectAll') %>">
        <%- icon('x', { size: 13 }) %>
      </button>
    </div>
  </div>
</div>

<!-- Modals -->

<!-- Create file / folder modal -->
<div id="createFileModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none">
  <div id="createFileModalPanel" class="al-sheet-panel rounded-2xl w-full sm:max-w-md shadow-xl will-change-transform sm:mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <div>
        <h2 id="createModalTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('newFile') %></h2>
        <p id="createModalHint" class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('newFileDesc') %></p>
      </div>
      <button type="button" id="closeCreateFileModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <input type="text" id="FileName" data-mode="file" class="al-input font-mono" placeholder="filename.txt or folder/filename.txt">
      <p id="fileNamePreview" class="mt-2 text-xs font-mono hidden"></p>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" id="cancelCreateFile" class="al-btn-secondary px-4 py-2 text-xs font-medium active:scale-95 inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmCreateFile" class="al-btn-primary px-4 py-2 text-xs font-medium active:scale-95 inline-flex items-center gap-2">
        <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('create') %>
      </button>
    </div>
  </div>
</div>

<!-- Rename modal -->
<div id="renameModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none">
  <div id="renameModalPanel" class="al-sheet-panel rounded-2xl w-full sm:max-w-md shadow-xl will-change-transform sm:mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('rename') %></h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('renameDesc') %></p>
      </div>
      <button type="button" id="closeRenameModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <input type="text" id="newFileName" class="al-input font-mono" placeholder="new-name.txt or subfolder/new-name.txt">
      <p id="renamePreview" class="mt-2 text-xs font-mono hidden"></p>
    </div>
    <input type="hidden" id="currentFileName">
    <input type="hidden" id="currentFilePath">
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" id="cancelRename" class="al-btn-secondary px-4 py-2 text-xs font-medium active:scale-95 inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmRename" class="al-btn-primary px-4 py-2 text-xs font-medium active:scale-95 inline-flex items-center gap-2">
        <%- icon('pencil', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('rename') %>
      </button>
    </div>
  </div>
</div>

<!-- Pull file from URL modal -->
<div id="pullFileModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div id="pullFileModalPanel" class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('pullFileFromUrl') %></h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('pullFileDesc') %></p>
      </div>
      <button type="button" id="closePullFileModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <div class="mb-4">
        <label for="pullUrlInput" class="mb-1.5 block text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('fileUrl') %></label>
        <input type="url" id="pullUrlInput" class="al-input w-full font-mono" placeholder="https://example.com/file.zip" autocomplete="off" spellcheck="false">
        <p id="pullUrlPreview" class="mt-2 text-xs font-mono hidden" style="color:var(--theme-text-muted)"></p>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" id="cancelPullFile" class="al-btn-secondary px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="pullButton" class="al-btn-primary px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('pull') %>
      </button>
    </div>
  </div>
</div>

<!-- Mass Delete Confirmation Modal -->
<div id="massDeleteModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div id="massDeleteModalPanel" class="al-sheet-panel rounded-2xl shadow-xl w-full max-w-sm mx-4 will-change-transform max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b">
      <div>
        <p class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('confirmMassDeletion') %></p>
      </div>
      <button type="button" id="closeMassDeleteModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="<%= t('close') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <p id="massDeleteMessage" class="text-xs leading-relaxed" style="color:var(--theme-text-muted)"></p>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end">
      <button type="button" id="cancelMassDelete" class="al-btn-secondary px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="confirmMassDelete" class="al-btn-danger px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('trash-2', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('delete') %>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
  window.__serverUUID = '<%= server.UUID %>';
  window.__currentPath = '<%= (typeof filesCurrentPath !== "undefined" && filesCurrentPath) ? filesCurrentPath.replace(/'/g, "\\'") : "" %>';
</script>
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/user/server/files.js') %>"></script>

<%- include('../../layouts/user-footer') %>
