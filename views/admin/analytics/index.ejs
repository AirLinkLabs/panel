<%- include('../../layouts/admin', { title: 'Admin Analytics' }) %>

<%- include('../../partials/flash-messages') %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbAnalytics') }
  ] }) %>

  <div class="flex items-start justify-between gap-4 mt-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= t('adminAnalyticsTitle') %></h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('analyticsLiveDesc') %></p>
    </div>
    <button type="button" id="refreshBtn" class="al-btn-secondary flex items-center gap-1.5 px-3 py-2 text-sm font-medium">
      <%- icon('refresh-cw', { id: 'refreshIcon', class: 'w-4 h-4', strokeWidth: 1.5 }) %>
      <%= t('analyticsRefreshBtn') %>
    </button>
  </div>

  <div class="mt-5" data-al-tabs data-tabs-default="servers" data-tabs-hash>
    <div role="tablist" class="flex gap-1 mb-6 flex-wrap">
      <button type="button" id="tab-servers" aria-controls="panel-servers" data-tab="servers" tabindex="0" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="true"><%- icon('server', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabServers') %></button>
      <button type="button" id="tab-nodes" aria-controls="panel-nodes" data-tab="nodes" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabNodes') %></button>
      <button type="button" id="tab-activity" aria-controls="panel-activity" data-tab="activity" tabindex="-1" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2" role="tab" aria-selected="false"><%- icon('activity', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('analyticsTabActivity') %></button>
    </div>

    <div id="loading-state" class="flex items-center gap-3 py-12" style="color:var(--theme-text-muted)">
      <%- icon('loader-circle', { class: 'animate-spin w-5 h-5', strokeWidth: 2 }) %>
      <span class="text-sm"><%= t('analyticsLoadingData') %></span>
    </div>

    <!-- SERVERS TAB -->
    <div id="panel-servers" data-tab-panel="servers" role="tabpanel" aria-labelledby="tab-servers" class="tab-panel space-y-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsTotalServers') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-total"><%= servers?.total ?? '--' %></p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsAllocatedRam') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-ram"><%= servers?.totalRamMb >= 1024 ? (servers.totalRamMb / 1024).toFixed(1) + ' GB' : (servers?.totalRamMb ?? 0) + ' MB' %></p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsAllocatedCpu') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-cpu"><%= servers?.totalCpuPct ?? 0 %>%</p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsAllocatedDisk') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="sv-storage"><%= servers?.totalStorageGb ?? 0 %> GB</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="al-card p-5">
          <p class="text-sm font-medium mb-4" style="color:var(--theme-text-strong)"><%= t('analyticsImagesInUse') %></p>
          <div id="sv-images" class="space-y-3">
            <% if (servers?.topImages && servers.topImages.length > 0) { %>
              <% servers.topImages.forEach(function(img) { %>
                <div class="flex justify-between text-xs mb-1.5" style="color:var(--theme-text-muted)">
                  <span class="truncate max-w-[60%] font-medium"><%= img.name %></span>
                  <span class="tabular-nums"><%= img.count %></span>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-sm" style="color:var(--theme-text-muted)">No servers yet.</p>
            <% } %>
          </div>
        </div>

        <div class="al-card overflow-hidden">
          <h2 class="al-card-header"><%= t('analyticsHighestAllocated') %></h2>
          <div class="divide-y divide-[var(--theme-border)]">
            <% if (servers?.topServers && servers.topServers.length > 0) { %>
              <% servers.topServers.forEach(function(sv) { %>
                <div class="flex items-center gap-4 px-5 py-3">
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium truncate" style="color:var(--theme-text-strong)"><%= sv.name %></p>
                    <p class="text-xs" style="color:var(--theme-text-muted)"><%= sv.owner %> &middot; <%= sv.image %></p>
                  </div>
                  <div class="flex items-center gap-3 shrink-0 text-xs tabular-nums" style="color:var(--theme-text-muted)">
                    <span><%= sv.memory %> MB</span>
                    <span>&middot;</span>
                    <span><%= sv.cpu %>%</span>
                    <span>&middot;</span>
                    <span><%= sv.storage %> GB</span>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <p class="px-5 py-4 text-sm" style="color:var(--theme-text-muted)">No servers.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- NODES TAB -->
    <div id="panel-nodes" data-tab-panel="nodes" role="tabpanel" aria-labelledby="tab-nodes" class="tab-panel space-y-4" hidden>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsNodesLabel') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)"><%= nodes?.length ?? 0 %></p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsOnlineLabel') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-success)" id="nd-online">--</p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsOfflineLabel') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-danger)" id="nd-offline">--</p>
        </div>
      </div>
      <div id="nd-list" class="space-y-3"></div>
    </div>

    <!-- ACTIVITY TAB -->
    <div id="panel-activity" data-tab-panel="activity" role="tabpanel" aria-labelledby="tab-activity" class="tab-panel space-y-6" hidden>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsUsersLabel') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)"><%= activity?.totalUsers ?? 0 %></p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsImagesInstalled') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)"><%= activity?.totalImages ?? 0 %></p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsLogins30d') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-logins">--</p>
        </div>
        <div class="al-card px-4 py-4">
          <p class="al-section-label"><%= t('analyticsAvgPerDay') %></p>
          <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong)" id="ac-avg">--</p>
        </div>
      </div>

      <div class="al-card overflow-hidden">
        <h2 class="al-card-header"><%= t('analyticsRecentLogins') %></h2>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm divide-y divide-[var(--theme-border)]">
            <thead style="background:var(--theme-bg-secondary)">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('analyticsUserId') %></th>
                <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('ipAddress') %></th>
                <th class="px-5 py-3 text-left text-xs font-medium" style="color:var(--theme-text-muted)"><%= t('activityTime') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--theme-border)]">
              <% if (activity?.recentLogins && activity.recentLogins.length > 0) { %>
                <% activity.recentLogins.forEach(function(l) { %>
                  <tr class="hover:bg-[var(--theme-bg-secondary)] transition">
                    <td class="px-5 py-3 text-xs font-mono" style="color:var(--theme-text-muted)">#<%= l.userId %></td>
                    <td class="px-5 py-3 text-xs font-mono" style="color:var(--theme-text-muted)"><%= l.ipAddress || 'Unknown' %></td>
                    <td class="px-5 py-3 text-xs" style="color:var(--theme-text-muted)"><%= new Date(l.timestamp).toLocaleString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="3" class="px-5 py-5 text-center text-sm" style="color:var(--theme-text-muted)">No login history.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
(function() {
  var loginsByDay = <%- JSON.stringify(activity?.loginsByDay || {}) %>;
  var nodes = <%- JSON.stringify(nodes || []) %>;
  var totalLogins = Object.values(loginsByDay).reduce(function(s, v) { return s + v; }, 0);
  var avgPerDay = Math.round(totalLogins / 30);

  var loginsEl = document.getElementById('ac-logins');
  var avgEl = document.getElementById('ac-avg');
  if (loginsEl) loginsEl.textContent = totalLogins;
  if (avgEl) avgEl.textContent = avgPerDay;

  // Node status (client-side check)
  var online = 0, offline = 0;
  nodes.forEach(function(n) { if (n.online) online++; else offline++; });
  var onEl = document.getElementById('nd-online');
  var offEl = document.getElementById('nd-offline');
  if (onEl) onEl.textContent = online;
  if (offEl) offEl.textContent = offline;

  // Render node list
  var listEl = document.getElementById('nd-list');
  if (listEl && nodes.length) {
    listEl.innerHTML = nodes.map(function(n) {
      return '<div class="al-card p-5">' +
        '<div class="flex items-center justify-between mb-4">' +
          '<div class="flex items-center gap-3">' +
            '<span class="w-2 h-2 rounded-full ' + (n.online ? 'bg-emerald-500' : 'bg-red-500') + ' shrink-0"></span>' +
            '<div><p class="text-sm font-medium" style="color:var(--theme-text-strong)">' + n.name + '</p>' +
            '<p class="text-xs font-mono" style="color:var(--theme-text-muted)">' + n.address + ':' + n.port + '</p></div>' +
          '</div>' +
          '<span class="text-xs px-2 py-0.5 rounded-md ' + (n.online ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200') + '">' + (n.online ? 'Online' : 'Offline') + '</span>' +
        '</div>' +
        '<div class="grid grid-cols-3 gap-4">' +
          '<div><p class="text-[10px] uppercase tracking-wider mb-1" style="color:var(--theme-text-muted)">RAM</p><p class="text-sm font-medium" style="color:var(--theme-text-strong)">' + (n.ram >= 1024 ? (n.ram / 1024).toFixed(1) + ' GB' : n.ram + ' MB') + '</p></div>' +
          '<div><p class="text-[10px] uppercase tracking-wider mb-1" style="color:var(--theme-text-muted)">CPU</p><p class="text-sm font-medium" style="color:var(--theme-text-strong)">' + n.cpu + '%</p></div>' +
          '<div><p class="text-[10px] uppercase tracking-wider mb-1" style="color:var(--theme-text-muted)">Disk</p><p class="text-sm font-medium" style="color:var(--theme-text-strong)">' + n.disk + ' GB</p></div>' +
        '</div></div>';
    }).join('');
  }

  document.getElementById('loading-state').classList.add('hidden');

  document.getElementById('refreshBtn').addEventListener('click', function() {
    window.location.reload();
  });
})();
</script>

<%- include('../../layouts/admin-footer') %>
