<%- include('../../components/header', { title: t('apiKeysManagement') }) %>

<style>
  .category-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s cubic-bezier(0.16,1,0.3,1), opacity 0.15s ease;
    opacity: 0;
  }
  .category-panel.open {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .category-panel > div {
    overflow: hidden;
    min-height: 0;
  }
</style>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('breadcrumbApiKeys') }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= t('apiKeysManagement') %></h1>
          <p class="al-page-desc"><%= t('apiKeysDesc') %></p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="openCreateApiKeyModal" type="button" class="al-btn-primary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('createApiKey') %></button>
          <a href="/admin/api/docs" class="al-btn-secondary"><%= t('apiDocs') %></a>
        </div>
      </div>
      <div class="al-page-body space-y-3" id="admin-apikeys-list">
        <%- include('../../fragments/admin/apikeys/key-list', { apiKeys, settings, req }) %>
      </div>
    </div>
  </div>
</main>

<div id="apikeyPage">

<div id="createApiKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center overflow-y-auto hidden" aria-hidden="true" style="">
  <div class="fixed inset-0 bg-transparent" aria-hidden="true" id="createApiKeyBackdrop"></div>
  <div id="createApiKeyPanel" class="al-sheet-panel relative my-auto mx-4 rounded-2xl shadow-xl w-full max-w-2xl" role="dialog" aria-modal="true" aria-labelledby="createApiKeyTitle" aria-describedby="createApiKeyDescription" tabindex="-1" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

      <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
        <div>
          <h3 id="createApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);"><%= t('createApiKeyModal') %></h3>
          <p id="createApiKeyDescription" class="text-xs mt-0.5" style="color:var(--theme-text-muted);"><%= t('apiKeySetNameDesc') %></p>
        </div>
        <button type="button" id="closeCreateApiKeyModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="<%= t('ariaClose') %>">
          <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
        </button>
      </div>

      <form id="createApiKeyForm" class="px-6 py-4 space-y-5">
        <%- include('../../components/csrf') %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);"><%= t('apiKeyName') %></label>
            <input type="text" name="name" id="name" required
              class="block w-full rounded-xl px-3 py-2 text-sm border transition focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)]"
              style="background:var(--theme-bg-input);border-color:var(--theme-border);color:var(--theme-text-strong);"
              placeholder="<%= t('apiKeyNamePlaceholder') %>">
          </div>
          <div>
            <label for="description" class="block text-xs font-medium mb-1.5" style="color:var(--theme-text-muted);"><%= t('apiKeyDescriptionLabel') %> <span style="color:var(--theme-text-placeholder);" class="font-normal"><%= t('apiKeyOptionalLabel') %></span></label>
            <input type="text" name="description" id="description"
              class="block w-full rounded-xl px-3 py-2 text-sm border transition focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)]"
              style="background:var(--theme-bg-input);border-color:var(--theme-border);color:var(--theme-text-strong);"
              placeholder="<%= t('apiKeyPlaceholderDesc') %>">
          </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);"><%= t('apiKeyPresets') %></p>
        <div class="flex gap-2">
          <button type="button" data-preset="full-admin" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('shield', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyFullAdmin') %>
          </button>
          <button type="button" data-preset="read-only" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyReadOnlyPreset') %>
          </button>
          <button type="button" data-preset="server-manager" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('server', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyServerManager') %>
          </button>
          <button type="button" data-preset="user-manager" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('user', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyUserManager') %>
          </button>
          <button type="button" data-preset="node-monitor" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('monitor', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyNodeMonitor') %>
          </button>
          <button type="button" data-preset="none" class="preset-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-150 active:scale-95 inline-flex items-center gap-1.5 hover:border-[var(--theme-border-accent)] hover:bg-[var(--theme-bg-hover)]" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text)">
            <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %><%= t('apiKeyClearAll') %>
          </button>
        </div>
        </div>

        <div>
          <p class="text-xs font-medium mb-2" style="color:var(--theme-text-muted);"><%= t('apiKeyPermissions') %></p>
          <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
            <% ['servers', 'users', 'nodes', 'settings'].forEach(category => { %>
              <div class="rounded-xl border overflow-hidden" style="border-color:var(--theme-border);">
                <button type="button"
                  class="category-toggle w-full flex items-center justify-between px-4 py-2.5 text-left transition-colors duration-150 hover:bg-[var(--theme-bg-hover)]"
                  style="background:var(--theme-bg-secondary);"
                  data-category="create_<%= category %>">
                  <div class="flex items-center gap-2">
                    <% if (category === 'servers') { %>
                      <%- icon('server', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else if (category === 'users') { %>
                      <%- icon('user', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else if (category === 'nodes') { %>
                      <%- icon('hard-drive', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } else { %>
                      <%- icon('key', { size: 16, class: 'shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                    <% } %>
                    <span class="text-xs font-medium capitalize" style="color:var(--theme-text);"><%= category %></span>
                    <span class="category-count text-[10px]" style="color:var(--theme-text-muted)" data-category="<%= category %>">0 selected</span>
                  </div>
                  <%- icon('chevron-down', { size: 14, class: 'category-chevron transition-transform duration-200 shrink-0', style: 'color:var(--theme-text-muted)' }) %>
                </button>
                <div class="category-panel" data-create-category="<%= category %>" style="background:var(--theme-bg-card);">
                  <div class="px-4 py-3 border-t" style="border-color:var(--theme-border);">
                  <div class="grid grid-cols-2 gap-2">
                    <% allPermissions.filter(p => p.value.includes(category)).forEach(permission => { %>
                      <label class="flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-all duration-150 hover:border-[var(--theme-border)] has-[:checked]:border-[var(--theme-accent)] has-[:checked]:bg-[var(--theme-accent-subtle)]"
                        style="border-color:var(--theme-border);background:var(--theme-bg-secondary);">
                        <input type="checkbox"
                          data-perm="<%= permission.value %>"
                          class="create-perm h-3.5 w-3.5 rounded shrink-0">
                        <span class="text-xs" style="color:var(--theme-text-muted);"><%= permission.name.split(' - ')[1] || permission.name %></span>
                      </label>
                    <% }); %>
                  </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="flex gap-2 py-4 border-t justify-end" style="border-color:var(--theme-border);">
          <button type="button" id="cancelCreateApiKey"
            class="px-4 py-2 text-xs font-medium rounded-xl border transition active:scale-95 inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]"
            style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text);">
            <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
            <%= t('cancel') %>
          </button>
          <button type="submit"
            class="px-4 py-2 text-xs font-medium rounded-xl transition active:scale-95 inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]"
            style="background:var(--theme-primary);color:var(--theme-accent-text);">
            <%- icon('plus', { class: 'size-3', strokeWidth: 1.5 }) %>
            <%= t('createApiKey') %>
          </button>
        </div>

      </form>
    </div>
</div>


<div id="editApiKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center hidden" aria-hidden="true" style="">
  <div class="absolute inset-0 bg-transparent" id="editApiKeyModalBackdrop"></div>
  <div id="editApiKeyModalPanel" role="dialog" aria-modal="true" aria-labelledby="editApiKeyTitle" aria-describedby="editApiKeyDescription" tabindex="-1" class="al-sheet-panel relative rounded-2xl shadow-xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">

    <!-- Header -->
    <div class="flex justify-between items-center px-6 py-4 border-b shrink-0" style="border-color:var(--theme-border);">
      <div>
        <p id="editApiKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);"><%= t('editApiKey') %></p>
        <p id="editApiKeyDescription" class="text-xs mt-0.5" style="color:var(--theme-text-muted);"><%= t('apiKeyEditDesc') %></p>
      </div>
      <button type="button" id="closeEditApiKeyModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>

    <!-- Body -->
    <form id="editApiKeyForm" class="flex flex-col min-h-0 flex-1">
      <%- include('../../components/csrf') %>
      <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 space-y-4">

        <!-- Name + description -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--theme-text-muted);"><%= t('apiKeyName') %></label>
            <input type="text" name="name" id="edit-name" required
              class="w-full rounded-xl border text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)] transition"
              style="border-color:var(--theme-border);background:var(--theme-bg-secondary);color:var(--theme-text-strong);"
              placeholder="<%= t('apiKeyNamePlaceholder') %>">
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--theme-text-muted);"><%= t('apiKeyDescriptionLabel') %></label>
            <input type="text" name="description" id="edit-description"
              class="w-full rounded-xl border text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--theme-border-accent)] transition"
              style="border-color:var(--theme-border);background:var(--theme-bg-secondary);color:var(--theme-text-strong);"
              placeholder="<%= t('apiKeyPlaceholderDesc') %>">
          </div>
        </div>

        <!-- Quick select -->
        <div class="flex gap-2">
          <button type="button" id="editSelectAllBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('check-check', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('selectAll') %></button>
          <button type="button" id="editSelectNoneBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('clearAll') %></button>
          <button type="button" id="editSelectReadOnlyBtn" class="text-xs px-3 py-1.5 rounded-lg border transition inline-flex items-center gap-1.5 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);border-color:var(--theme-border);color:var(--theme-text-muted);"><%- icon('eye', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('apiKeyReadOnlyPerm') %></button>
        </div>

        <!-- Permissions grid -->
        <div class="space-y-3">
          <% ['servers', 'users', 'nodes', 'settings'].forEach(cat => { %>
          <div class="rounded-xl border overflow-hidden" style="border-color:var(--theme-border);">
            <div class="flex items-center justify-between px-4 py-2.5" style="background:var(--theme-bg-secondary);">
              <p class="text-xs font-semibold capitalize" style="color:var(--theme-text-muted);"><%= cat %></p>
              <button type="button" class="edit-select-category text-xs transition hover:text-[var(--theme-text)]" style="color:var(--theme-text-muted);" data-category="<%= cat %>"><%= t('selectAll') %></button>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1.5 px-4 py-3">
              <% allPermissions.filter(p => p.value.includes(cat)).forEach(permission => { %>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox"
                  data-perm="<%= permission.value %>"
                  class="edit-perm h-3.5 w-3.5 rounded focus:ring-[var(--theme-border-accent)]">
                <span class="text-xs transition group-hover:text-[var(--theme-text-strong)]" style="color:var(--theme-text);"><%= permission.name %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>

      </div>

      <!-- Footer -->
      <div class="flex gap-2 px-6 py-4 border-t justify-end shrink-0" style="border-color:var(--theme-border);">
         <button type="button" id="cancelEditApiKey" class="px-4 py-2 text-xs font-medium rounded-xl transition inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-bg-secondary);color:var(--theme-text);"><%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('cancel') %></button>
        <button type="submit" class="px-4 py-2 text-xs font-medium rounded-xl transition inline-flex items-center gap-2 hover:bg-[var(--theme-bg-hover)]" style="background:var(--theme-primary);color:var(--theme-accent-text);"><%- icon('save', { class: 'size-3', strokeWidth: 1.5 }) %> <%= t('apiKeySaveChanges') %></button>
      </div>
    </form>
  </div>
</div>

<% if (created) { %>
<div id="createdKeyModal" class="al-sheet-overlay fixed inset-0 z-50 items-center justify-center hidden" aria-hidden="true" style="">
  <div class="absolute inset-0 bg-transparent" id="createdKeyBackdrop"></div>
  <div id="createdKeyPanel" role="dialog" aria-modal="true" aria-labelledby="createdKeyTitle" tabindex="-1" class="al-sheet-panel relative rounded-2xl shadow-xl w-full max-w-lg mx-4 max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border-color:var(--theme-border);">
    <div class="flex justify-between items-center px-6 py-4 border-b" style="border-color:var(--theme-border);">
      <h3 id="createdKeyTitle" class="text-sm font-semibold" style="color:var(--theme-text-strong);"><%= t('apiKeyCreatedTitle') %></h3>
      <button type="button" id="closeCreatedKeyModal" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" style="color:var(--theme-text-muted);" aria-label="Close">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs mb-4" style="color:var(--theme-text-muted);"><%= t('apiKeyCopyNotice') %></p>
      <div class="flex items-center gap-2 rounded-xl px-3 py-2.5" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border)">
        <code class="flex-1 text-xs font-mono break-all" style="color:var(--theme-text-strong)"><%= created %></code>
      </div>
    </div>
    <div class="flex gap-2 px-6 py-4 border-t justify-end" style="border-color:var(--theme-border);">
      <button type="button" id="closeCreatedKeyModalBtn" class="al-btn-secondary"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('close') %></button>
      <button type="button" id="copyCreatedKeyBtn" class="al-btn-primary"><%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %> <%= t('apiKeyCopyKeyBtn') %></button>
    </div>
  </div>
</div>
<% } %>

</div>



<script nonce="<%- nonce %>">
(function() {
  var createForm = { name: '', description: '', permissions: [] };
  var editForm = { id: 0, name: '', description: '', permissions: [] };
  var activePreset = null;
  var createdKey = '<%= typeof created !== "undefined" ? created : "" %>';

  var presetPermissions = {
    'full-admin': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.nodes.read','airlink.api.nodes.create','airlink.api.nodes.update','airlink.api.nodes.delete','airlink.api.settings.read','airlink.api.settings.update'],
    'read-only': ['airlink.api.servers.read','airlink.api.users.read','airlink.api.nodes.read','airlink.api.settings.read'],
    'server-manager': ['airlink.api.servers.read','airlink.api.servers.create','airlink.api.servers.update','airlink.api.servers.delete','airlink.api.nodes.read'],
    'user-manager': ['airlink.api.users.read','airlink.api.users.create','airlink.api.users.update','airlink.api.users.delete','airlink.api.servers.read'],
    'node-monitor': ['airlink.api.nodes.read','airlink.api.servers.read'],
    'none': []
  };

  var allPermissions = <%- JSON.stringify(allPermissions) %>;

  function showModal(id) { document.getElementById(id).classList.remove('hidden'); }
  function hideModal(id) { document.getElementById(id).classList.add('hidden'); }

  function applyPreset(name) {
    activePreset = name;
    createForm.permissions = [].concat(presetPermissions[name] || []);
    document.querySelectorAll('.preset-btn').forEach(function(btn) {
      var isActive = btn.dataset.preset === name;
      if (isActive) {
        btn.style.background = 'var(--theme-primary)';
        btn.style.color = 'var(--theme-accent-text)';
        btn.style.borderColor = 'var(--theme-primary)';
      } else {
        btn.style.background = 'var(--theme-bg-card)';
        btn.style.color = 'var(--theme-text)';
        btn.style.borderColor = 'var(--theme-border)';
      }
    });
    syncCreatePermCheckboxes();
  }

  function toggleCreatePerm(perm) {
    var idx = createForm.permissions.indexOf(perm);
    if (idx === -1) createForm.permissions.push(perm);
    else createForm.permissions.splice(idx, 1);
    syncCreatePermCheckboxes();
  }

  function syncCreatePermCheckboxes() {
    document.querySelectorAll('.create-perm').forEach(function(cb) {
      cb.checked = createForm.permissions.indexOf(cb.dataset.perm) !== -1;
    });
    updateCategoryCounts('create');
  }

  function toggleEditPerm(perm) {
    var idx = editForm.permissions.indexOf(perm);
    if (idx === -1) editForm.permissions.push(perm);
    else editForm.permissions.splice(idx, 1);
    syncEditPermCheckboxes();
  }

  function syncEditPermCheckboxes() {
    document.querySelectorAll('.edit-perm').forEach(function(cb) {
      cb.checked = editForm.permissions.indexOf(cb.dataset.perm) !== -1;
    });
    updateCategoryCounts('edit');
  }

  function updateCategoryCounts(prefix) {
    var perms = prefix === 'create' ? createForm.permissions : editForm.permissions;
    ['servers','users','nodes','settings'].forEach(function(cat) {
      var count = perms.filter(function(p) { return p.indexOf(cat) !== -1; }).length;
      var el = document.querySelector('[data-category="' + cat + '"]');
      if (el) el.textContent = count + ' selected';
    });
  }

  async function submitCreate() {
    try {
      var csrfTokenEl = document.querySelector('meta[name="csrf-token"]');
      var csrfToken = csrfTokenEl ? csrfTokenEl.content : '';
      var params = new URLSearchParams();
      params.append('name', document.getElementById('name').value);
      params.append('description', document.getElementById('description').value);
      params.append('csrf-token', csrfToken);
      createForm.permissions.forEach(function(p) { params.append('permissions', p); });
      var res = await fetch('/api/v2/admin/apikeys', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'csrf-token': csrfToken },
        body: params,
      });
      if (res.ok) {
        showToast(window.__i18n.apiKeyCreated || 'API key created', 'success');
        hideModal('createApiKeyModal');
        window.location.href = '/admin/apikeys';
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || (window.__i18n.apiKeyCreateFailed || 'Failed to create key.'), 'error');
      }
    } catch (e) { showToast(window.__i18n.networkError || 'Network error.', 'error'); }
  }

  async function submitEdit() {
    try {
      var csrfTokenEl = document.querySelector('meta[name="csrf-token"]');
      var csrfToken = csrfTokenEl ? csrfTokenEl.content : '';
      var params = new URLSearchParams();
      params.append('name', document.getElementById('edit-name').value);
      params.append('description', document.getElementById('edit-description').value);
      params.append('csrf-token', csrfToken);
      editForm.permissions.forEach(function(p) { params.append('permissions', p); });
      var res = await fetch('/api/v2/admin/apikeys/' + editForm.id, {
        method: 'PUT',
        headers: { 'Accept': 'application/json', 'csrf-token': csrfToken },
        body: params,
      });
      if (res.ok) {
        showToast(window.__i18n.apiKeyUpdated || 'API key updated', 'success');
        hideModal('editApiKeyModal');
        window.location.reload();
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || (window.__i18n.apiKeyUpdateFailed || 'Failed to update key.'), 'error');
      }
    } catch (e) { showToast(window.__i18n.networkError || 'Network error.', 'error'); }
  }

  async function deleteKey(keyId) {
    var form = document.getElementById('deleteKeyForm_' + keyId);
    if (!form) return;
    try {
      var res = await fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new URLSearchParams(new FormData(form)) });
      if (res.ok) {
        showToast(window.__i18n.apiKeyDeleted || 'API key deleted', 'success');
        window.location.reload();
      } else {
        var data = await res.json().catch(function() { return {}; });
        showToast(data.error || (window.__i18n.apiKeyDeleteFailed || 'Failed to delete key.'), 'error');
      }
    } catch (e) { showToast(window.__i18n.networkError || 'Network error.', 'error'); }
  }

  async function toggleKey(keyId, enabling) {
    var form = document.getElementById('toggleKeyForm_' + keyId);
    if (!form) return;
    try {
      var res = await fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new URLSearchParams(new FormData(form)) });
      if (res.ok) {
        showToast(enabling ? (window.__i18n.apiKeyEnabled || 'API key enabled') : (window.__i18n.apiKeyDisabled || 'API key disabled'), 'success');
        window.location.reload();
      }
    } catch (e) { showToast(window.__i18n.networkError || 'Network error.', 'error'); }
  }

  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() { showToast(window.__i18n.apiKeyCopied || 'API key copied to clipboard', 'success'); }).catch(function() { showToast(window.__i18n.apiKeyCopyFailed || 'Failed to copy', 'error'); });
  }

  // Event listeners
  document.getElementById('openCreateApiKeyModal').addEventListener('click', function() { showModal('createApiKeyModal'); });
  document.getElementById('closeCreateApiKeyModal').addEventListener('click', function() { hideModal('createApiKeyModal'); });
  document.getElementById('createApiKeyBackdrop').addEventListener('click', function() { hideModal('createApiKeyModal'); });
  document.getElementById('cancelCreateApiKey').addEventListener('click', function() { hideModal('createApiKeyModal'); });
  document.getElementById('createApiKeyForm').addEventListener('submit', function(e) { e.preventDefault(); submitCreate(); });

  document.getElementById('editApiKeyModalBackdrop').addEventListener('click', function() { hideModal('editApiKeyModal'); });
  document.getElementById('closeEditApiKeyModal').addEventListener('click', function() { hideModal('editApiKeyModal'); });
  document.getElementById('cancelEditApiKey').addEventListener('click', function() { hideModal('editApiKeyModal'); });
  document.getElementById('editApiKeyForm').addEventListener('submit', function(e) { e.preventDefault(); submitEdit(); });

  <% if (created) { %>
  document.getElementById('createdKeyBackdrop').addEventListener('click', function() { hideModal('createdKeyModal'); });
  document.getElementById('closeCreatedKeyModal').addEventListener('click', function() { hideModal('createdKeyModal'); });
  document.getElementById('closeCreatedKeyModalBtn').addEventListener('click', function() { hideModal('createdKeyModal'); });
  document.getElementById('copyCreatedKeyBtn').addEventListener('click', function() { copyToClipboard(createdKey); });
  <% } %>

  document.querySelectorAll('.preset-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { applyPreset(this.dataset.preset); });
  });

  document.querySelectorAll('.category-toggle[data-category]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var panel = document.querySelector('[data-create-category="' + this.dataset.category.replace('create_', '') + '"]');
      if (panel) panel.classList.toggle('open');
    });
  });

  document.querySelectorAll('.create-perm').forEach(function(cb) {
    cb.addEventListener('change', function() { toggleCreatePerm(this.dataset.perm); });
  });

  document.querySelectorAll('.edit-perm').forEach(function(cb) {
    cb.addEventListener('change', function() { toggleEditPerm(this.dataset.perm); });
  });

  document.getElementById('editSelectAllBtn').addEventListener('click', function() {
    editForm.permissions = allPermissions.map(function(p) { return p.value; });
    syncEditPermCheckboxes();
  });

  document.getElementById('editSelectNoneBtn').addEventListener('click', function() {
    editForm.permissions = [];
    syncEditPermCheckboxes();
  });

  document.getElementById('editSelectReadOnlyBtn').addEventListener('click', function() {
    editForm.permissions = allPermissions.filter(function(p) { return p.value.indexOf('.read') !== -1; }).map(function(p) { return p.value; });
    syncEditPermCheckboxes();
  });

  document.querySelectorAll('.edit-select-category').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var cat = this.dataset.category;
      var catPerms = allPermissions.filter(function(p) { return p.value.indexOf(cat) !== -1; }).map(function(p) { return p.value; });
      var allChecked = catPerms.every(function(p) { return editForm.permissions.indexOf(p) !== -1; });
      if (allChecked) {
        editForm.permissions = editForm.permissions.filter(function(p) { return catPerms.indexOf(p) === -1; });
      } else {
        catPerms.forEach(function(p) { if (editForm.permissions.indexOf(p) === -1) editForm.permissions.push(p); });
      }
      syncEditPermCheckboxes();
    });
  });

  // Expose for external callers (key-list fragment)
  window.showEditModal = function(id, name, desc, perms) {
    try { perms = typeof perms === 'string' ? JSON.parse(perms) : perms; } catch(e) { perms = []; }
    editForm = { id: id, name: name, description: desc || '', permissions: [].concat(perms) };
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-description').value = desc || '';
    syncEditPermCheckboxes();
    showModal('editApiKeyModal');
  };

  window.confirmDeleteApiKey = function(keyId) {
    window.modal.confirm({
      title: window.__i18n.apiKeyDeleteTitle || 'Delete API key', body: window.__i18n.apiKeyDeleteConfirm || 'This will permanently revoke the key. Any integrations using it will stop working.',
      danger: true, confirmLabel: window.__i18n.apiKeyDeleteAction || 'Yeah, delete it',
      onConfirm: function() { deleteKey(keyId); }
    });
  };

  // Show created modal if key was just created
  if (createdKey) showModal('createdKeyModal');

  // Escape key to close modals
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (!document.getElementById('createApiKeyModal').classList.contains('hidden')) hideModal('createApiKeyModal');
      if (!document.getElementById('editApiKeyModal').classList.contains('hidden')) hideModal('editApiKeyModal');
      if (!document.getElementById('createdKeyModal').classList.contains('hidden')) hideModal('createdKeyModal');
    }
  });

  syncCreatePermCheckboxes();
  syncEditPermCheckboxes();
})();
</script>

<%- include('../../components/footer') %>
