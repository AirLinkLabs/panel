<%- include('../../components/header', { title: t('addonsTitle') }) %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('addonsTitle') }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= t('addonsTitle') %></h1>
          <p class="al-page-desc"><%= t('addonsDesc') %></p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="reloadBtn" type="button" class="al-btn-secondary"><%- icon('refresh-cw', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('addonReload') %></button>
        </div>
      </div>

      <div class="al-page-body">
      <div class="flex">
        <span class="px-3 py-2 mr-4 text-sm font-medium rounded-lg" style="background:var(--theme-primary);color:var(--theme-accent-text)"><%= t('addonInstalledTab') %> <span class="ml-1 text-xs" style="color:var(--theme-text-muted)"><%= addons ? addons.length : 0 %></span></span>
        <a href="/admin/addons/store" class="px-3 py-2 text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('addonStoreTab') %></a>
      </div>

      <% if (!addonTableExists) { %>
      <div class="mt-5 rounded-xl bg-amber-600/20 dark:bg-amber-800/10 px-4 py-4 border-0 flex items-start gap-3" style="border-color:var(--theme-warning)">
        <%- icon('triangle-alert', { size: 20, class: 'mt-0.5 shrink-0', style: 'color:var(--theme-warning)' }) %>
        <div>
          <p class="text-sm font-medium" style="color:var(--theme-warning);"><%= t('addonDatabaseMigrationRequired') %></p>
          <p class="mt-1 text-xs" style="color:var(--theme-warning);opacity:0.8;"><%= t('addonMigrationHint', { code: 'npm run migrate:dev' }) %></p>
        </div>
      </div>
      <% } %>

      <% if (addons && addons.length > 0) { %>
      <div class="mt-5 mb-1">
        <input id="addonSearchInput" type="text" placeholder="<%= t('addonFilterPlaceholder') %>" aria-label="<%= t('ariaSearchAddons') %>" class="al-input w-56">
      </div>
      <div class="overflow-x-auto shadow-sm rounded-xl mt-3 border" style="border-color:var(--theme-border)">
        <table class="al-table min-w-full">
          <colgroup>
            <col style="min-width:240px">
            <col style="min-width:160px">
            <col style="min-width:120px">
            <col style="min-width:200px">
          </colgroup>
          <thead class="al-table-head">
            <tr>
              <th class="al-table-th py-3.5 pl-6 pr-3"><%= t('name') %></th>
              <th class="al-table-th px-3 py-3.5 col-hide"><%= t('version') %></th>
              <th class="al-table-th px-3 py-3.5 col-hide"><%= t('status') %></th>
              <th class="al-table-th px-3 py-3.5"><%= t('actions') %></th>
            </tr>
          </thead>
          <tbody class="divide-y" style="border-color:var(--theme-border)">
            <% let addonIdx = 0; addons.forEach(function(addon) { %>
            <tr class="al-table-tr transition-colors addon-row"
                style="--i:<%= addonIdx++ %>"
                data-slug="<%= addon.slug %>"
                data-search="<%= (addon.name + ' ' + (addon.description||'') + ' ' + (addon.author||'')).toLowerCase() %>">
              <td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3">
                <p class="font-medium" style="color:var(--theme-text-strong)"><%= addon.name %></p>
                <% if (addon.description) { %><p class="text-xs mt-0.5 max-w-xs truncate" style="color:var(--theme-text-muted)"><%= addon.description %></p><% } %>
              </td>
              <td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">v<%= addon.version %><% if (addon.author) { %> · <%= addon.author %><% } %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm col-hide">
                <% if (addon.hasDisabledPh) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-warning-bg);color:var(--theme-warning);--tw-ring-color:color-mix(in srgb, var(--theme-warning) 25%, transparent);"><%= t('addonNotEnabled') %></span>
                <% } else if (addon.enabled) { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-success-bg);color:var(--theme-success);--tw-ring-color:color-mix(in srgb, var(--theme-success) 25%, transparent);"><%= t('addonEnabled') %></span>
                <% } else { %>
                <span class="status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset" style="background:var(--theme-bg-secondary);color:var(--theme-text-muted);box-shadow:inset 0 0 0 1px var(--theme-border)"><%= t('addonDisabled') %></span>
                <% } %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <div class="flex gap-2">
                  <button data-action="toggle" data-slug="<%= addon.slug %>" data-enable="<%= !addon.enabled %>" type="button"
                    class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition">
                    <%= addon.enabled ? t('addonDisable') : t('addonEnable') %>
                  </button>
                  <button data-action="uninstall" data-slug="<%= addon.slug %>" data-name="<%= addon.name %>" type="button"
                    class="al-btn-danger" aria-label="<%= t('addonUninstallAria', { name: addon.name }) %>">
                    <%- icon('trash-2', { size: 16, class: 'shrink-0' }) %>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div id="addonNoResults" class="hidden py-10 text-center text-sm" style="background:var(--theme-bg-card);color:var(--theme-text-muted)"><%= t('addonNoResults') %></div>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <p class="text-sm" style="color:var(--theme-text-muted)"><% if (addonTableExists) { %><%= t('addonNoInstalled') %><% } else { %><%= t('addonMigrationRequired') %><% } %></p>
        <% if (addonTableExists) { %>
        <a href="/admin/addons/store" class="mt-4 al-btn-secondary inline-flex items-center gap-1.5"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('addonBrowseStore') %></a>
        <% } %>
      </div>
      <% } %>
      </div>
    </div>
  </div>
</main>

<script nonce="<%- nonce %>">
function addonManager() {
  const BADGE_ENABLED = 'status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-emerald-600/20 dark:ring-emerald-400/20';
  const BADGE_DISABLED = 'status-badge inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-neutral-100 dark:bg-white/5 text-neutral-600 dark:text-neutral-300 ring-neutral-300 dark:ring-white/10';
  return {
    init() {
      document.getElementById('reloadBtn').addEventListener('click', () => {
        showProgressToast(window.__i18n.addonReloading || 'Reloading addons…');
        fetch('/api/v2/admin/addons/reload', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
          .then(r => r.json()).then(data => { showToast(data.message || (data.success ? (window.__i18n.addonReloaded || 'Reloaded') : (window.__i18n.failed || 'Failed')), data.success ? 'success' : 'error'); })
          .catch(() => { showToast(window.__i18n.somethingWentWrong || 'Something went wrong.', 'error'); });
      });
      const addonSearchInput = document.getElementById('addonSearchInput');
      if (addonSearchInput) {
        addonSearchInput.addEventListener('input', function() {
          const q = this.value.toLowerCase().trim();
          let visible = 0;
          document.querySelectorAll('.addon-row').forEach(row => {
            const match = !q || row.dataset.search.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
          });
          const noResults = document.getElementById('addonNoResults');
          if (noResults) noResults.classList.toggle('hidden', visible > 0 || !q);
        });
      }
    },
    toggleAddon(slug, enable) {
      showProgressToast(window.__i18n.applyingChanges || 'Applying changes…');
      fetch('/api/v2/admin/addons/' + slug + '/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: enable.toString() }),
      }).then(r => r.json()).then(data => {
        if (data.success) { showToast(window.__i18n.addonUpdated || 'Addon updated', 'success'); window.location.reload(); }
        else showToast(data.message || (window.__i18n.failed || 'Failed'), 'error');
      }).catch(() => { showToast(window.__i18n.somethingWentWrong || 'Something went wrong.', 'error'); });
    },
    updateRow(slug, enabled) {
      const row = document.querySelector('[data-slug="' + slug + '"]');
      if (!row) return;
      const badge = row.querySelector('.status-badge');
      if (badge) {
        badge.className = enabled ? BADGE_ENABLED : BADGE_DISABLED;
        badge.textContent = enabled ? (window.__i18n.addonEnabled || 'Enabled') : (window.__i18n.addonDisabled || 'Disabled');
      }
      const btn = row.querySelector('.toggle-btn');
      if (btn) { btn.textContent = enabled ? (window.__i18n.addonDisable || 'Disable') : (window.__i18n.addonEnable || 'Enable'); btn.onclick = () => this.toggleAddon(slug, !enabled); }
    },
    confirmUninstall(slug, name) {
      window.modal && window.modal.confirm
        ? window.modal.confirm({ title: window.__i18n.addonUninstallTitle || 'Uninstall Addon', body: (window.__i18n.addonUninstallConfirm || 'Uninstall "') + name + (window.__i18n.addonUninstallConfirmSuffix || '"? This cannot be undone.'), danger: true, confirmLabel: window.__i18n.addonUninstallAction || 'Uninstall', onConfirm: () => this.uninstall(slug) })
        : this.uninstall(slug);
    },
    uninstall(slug) {
      showProgressToast(window.__i18n.addonRemovingFiles || 'Removing files…');
      fetch('/api/v2/admin/addons/' + slug + '/uninstall', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }) })
        .then(r => r.json()).then(data => {
          if (data.success) { showToast(window.__i18n.addonUninstalled || 'Uninstalled', 'success'); window.location.reload(); }
          else showToast(data.message || (window.__i18n.failed || 'Failed'), 'error');
        }).catch(() => { showToast(window.__i18n.somethingWentWrong || 'Something went wrong.', 'error'); });
    }
  };
}

(function() {
  var mgr = addonManager();
  mgr.init();

  document.querySelectorAll('[data-action="toggle"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      mgr.toggleAddon(this.dataset.slug, this.dataset.enable === 'true');
    });
  });

  document.querySelectorAll('[data-action="uninstall"]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      mgr.confirmUninstall(this.dataset.slug, this.dataset.name);
    });
  });
})();
</script>

<%- include('../../components/footer') %>
