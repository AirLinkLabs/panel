<%- include('../../components/header', { title: t('addDatabaseHostTitle') }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('adminDatabaseBreadcrumbDb'), href: '/admin/databases' },
        { label: t('adminDatabaseBreadcrumbAddHost') }
      ] }) %>
      <div class="al-page-header mb-5 flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= t('addDatabaseHostTitle') %></h1>
          <p class="al-page-desc"><%= t('addDatabaseHostDesc') %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <%- include('../../components/ui/save-button', { formId: 'hostForm', label: t('saveHost') }) %>
          <a href="/admin/databases" class="al-btn-secondary"><%= t('backToDatabases') %></a>
        </div>
      </div>

      <div id="hostForm" class="al-page-body space-y-5">
        <div id="dbError" class="rounded-xl px-4 py-3 text-sm hidden" style="background:var(--theme-danger-bg);border:1px solid color-mix(in srgb, var(--theme-danger) 25%, transparent);color:var(--theme-danger)"></div>
        <form onsubmit="event.preventDefault(); submitDbHost();" class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header"><%= t('connectionDetails') %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="md:col-span-2">
                <label for="hostName" class="al-label flex items-center gap-1.5">
                  <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('hostName') %>
                </label>
                <input id="hostName" class="al-input" placeholder="<%= t('hostName') %>" required>
              </div>

              <div>
                <label for="hostAddress" class="al-label flex items-center gap-1.5">
                  <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('hostAddress') %>
                </label>
                <input id="hostAddress" class="al-input" placeholder="localhost or 10.0.0.5" required>
              </div>

              <div>
                <label for="hostPort" class="al-label flex items-center gap-1.5">
                  <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('portLabel') %>
                </label>
                <input id="hostPort" class="al-input" placeholder="<%= settings.defaultDbPort ?? 3306 %>" type="number">
              </div>

              <div>
                <label for="hostUser" class="al-label flex items-center gap-1.5">
                  <%- icon('user', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('usernameLabelForm') %>
                </label>
                <input id="hostUser" class="al-input" placeholder="root" autocomplete="off" required>
              </div>

              <div>
                <label for="hostPassword" class="al-label flex items-center gap-1.5">
                  <%- icon('lock', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('passwordLabelForm') %>
                </label>
                <input id="hostPassword" type="password" class="al-input" placeholder="••••••••" autocomplete="new-password" required>
              </div>
              <div>
                <label for="hostNode" class="al-label flex items-center gap-1.5">
                  <%- icon('network', { width: 14, height: 14, class: 'shrink-0' }) %>
                  <%= t('nodeLabel') %>
                </label>
                <select id="hostNode" class="al-input">
                  <option value=""><%= t('anyNodeUnscoped') %></option>
                  <% (nodes || []).forEach(n => { %>
                    <option value="<%= n.id %>"><%= n.name %></option>
                  <% }); %>
                </select>
                <p class="mt-1.5 text-[11px]" style="color:var(--theme-text-muted)"><%= t('nodeScopeHint') %></p>
              </div>
            </div>
          </div>
        </form>
      </div>

      <script nonce="<%- nonce %>">
      function submitDbHost() {
        var form = {
          name: document.getElementById('hostName').value,
          host: document.getElementById('hostAddress').value,
          port: parseInt(document.getElementById('hostPort').value) || <%= settings.defaultDbPort ?? 3306 %>,
          username: document.getElementById('hostUser').value,
          password: document.getElementById('hostPassword').value,
          nodeId: document.getElementById('hostNode').value,
        };
        var errEl = document.getElementById('dbError');
        errEl.classList.add('hidden');

        if (!form.name || !form.host || !form.username || !form.password) {
          errEl.textContent = req.translations.fillAllRequiredFields || 'Please fill in all required fields.';
          errEl.classList.remove('hidden');
          return;
        }

        fetch('/api/v2/admin/databases', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
          body: JSON.stringify(form),
        }).then(function(res) {
          if (res.ok) {
            showToast(req.translations.dbHostAdded || 'Database host added.', 'success');
            setTimeout(function() { window.location.href = '/admin/databases'; }, 500);
          } else {
            return res.json().then(function(data) {
              errEl.textContent = data.error || data.message || (req.translations.dbHostCreateFailed || 'Failed to create host.');
              errEl.classList.remove('hidden');
            });
          }
        }).catch(function() {
          errEl.textContent = req.translations.networkErrorTryAgain || 'Network error. Try again.';
          errEl.classList.remove('hidden');
        });
      }
      </script>
    </div>
  </div>
</main>

<%- include('../../components/footer') %>
