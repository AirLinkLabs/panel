<%- include('../../components/header', { title: t('adminCreateUserTitle') }) %>

<main class="min-h-screen">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('breadcrumbUsers'), href: '/admin/users' },
        { label: t('create') }
      ] }) %>
      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= t('adminCreateUserTitle') %></h1>
          <p class="al-page-desc"><%= t('adminCreateUserText') %></p>
        </div>
        <div class="flex gap-2 shrink-0 items-center">
          <%- include('../../components/ui/save-button', { formId: 'createUserForm', label: t('create'), iconName: 'plus' }) %>
          <a href="/admin/users" class="al-btn-secondary"><%= t('backToUsers') %></a>
        </div>
      </div>

      <div class="al-page-body space-y-5">
        <div id="createUserError" class="hidden rounded-xl px-4 py-3 text-sm" style="background:var(--theme-danger-bg);border:1px solid color-mix(in srgb, var(--theme-danger) 25%, transparent);color:var(--theme-danger)"></div>
        <form id="createUserForm" onsubmit="event.preventDefault(); submitUserCreate()" class="space-y-5">
          <div class="al-card">
            <h2 class="al-card-header"><%= t('userInformation') %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="userEmail" class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)">
                  <%- icon('mail', { size: 14, class: 'shrink-0' }) %>
                  <%= t('email') %>:
                </label>
                <input id="userEmail" type="email" class="al-input" placeholder="example@domain.com">
              </div>

              <div>
                <label for="userUsername" class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)">
                  <%- icon('user', { size: 14, class: 'shrink-0' }) %>
                  <%= t('username') %>:
                </label>
                <input id="userUsername" type="text" class="al-input" placeholder="username">
                <div id="username-criteria" class="mt-2 space-y-1">
                  <p id="username-len-crit" class="text-xs text-neutral-400">
                    <span class="crit-icon">—</span> <%= t('usernameChars3to32') %>
                  </p>
                  <p id="username-chars-crit" class="text-xs text-neutral-400">
                    <span class="crit-icon">—</span> <%= t('lettersAndNumbersOnly') %>
                  </p>
                </div>
              </div>

              <div class="md:col-span-2">
                <label for="userDescription" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)">
                  <%= t('description') %>
                </label>
                <textarea id="userDescription" rows="3" class="al-input" placeholder="<%= t('optionalDescription') %>"></textarea>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header"><%= t('security') %></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="userPassword" class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)">
                  <%- icon('lock', { size: 14, class: 'shrink-0' }) %>
                  <%= t('password') %>:
                </label>
                <input id="userPassword" type="password" class="al-input" placeholder="********">
                <div id="password-criteria" class="mt-2 space-y-1">
                  <p id="pw-len-crit" class="text-xs text-neutral-400">
                    <span class="crit-icon">—</span> <%= t('atLeast8Characters') %>
                  </p>
                  <p id="pw-letter-crit" class="text-xs text-neutral-400">
                    <span class="crit-icon">—</span> <%= t('atLeastOneLetter') %>
                  </p>
                  <p id="pw-number-crit" class="text-xs text-neutral-400">
                    <span class="crit-icon">—</span> <%= t('atLeastOneNumber') %>
                  </p>
                </div>
              </div>

              <div>
                <label for="userConfirmPassword" class="block text-sm font-medium mb-2" style="color:var(--theme-text-strong)">
                  <%= t('confirmPassword') %>
                </label>
                <input id="userConfirmPassword" type="password" class="al-input" placeholder="********">
              </div>

              <div class="md:col-span-2">
                <div class="p-4 rounded-xl border w-full" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">
                        <%= t('role') %>
                      </h3>
                      <p class="text-xs mt-1" style="color:var(--theme-text-muted)">
                        <%= t('roleDescriptionCreate') %>
                      </p>
                    </div>
                    <select id="createRole" name="role" class="al-input w-44">
                      <option value="user"><%= t('roleUser') %></option>
                      <option value="privileged"><%= t('rolePrivileged') %></option>
                      <option value="admin"><%= t('roleAdmin') %></option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="md:col-span-2">
                <div class="p-4 rounded-xl border w-full" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)">
                        <%= t('adminStatus') %>
                      </h3>
                      <p class="text-xs mt-1" style="color:var(--theme-text-muted)">
                        <%= t('adminDescription') %>
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" id="createIsAdmin" aria-label="<%= t('adminStatus') %>" class="sr-only peer">
                      <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                      <span id="createIsAdminLabel" class="ms-3 text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('disabled') %></span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h2 class="al-card-header"><%= t('serverLimits') %></h2>
            <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('leaveBlankForDefaults') %></p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%- icon('sliders-horizontal', { size: 14, class: 'shrink-0' }) %> <%= t('serverLimit') %></label>
                <input type="number" id="createServerLimit" name="serverLimit" min="0" max="100" placeholder="<%= t('useGlobalDefault') %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('maxServersThisUserCanCreate') %></p>
              </div>
              <div>
                <label class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%- icon('memory-stick', { size: 14, class: 'shrink-0' }) %> <%= t('maxMemory') %></label>
                <input type="hidden" id="createMaxMemory" name="maxMemory">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="createMaxMemoryDisplay" min="128" max="65536" placeholder="<%= t('useGlobalDefault') %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="createMaxMemoryDisplay" data-hidden="createMaxMemory"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%- icon('cpu', { size: 14, class: 'shrink-0' }) %> <%= t('maxCpu') %> <span class="font-normal text-xs" style="color:var(--theme-text-muted)">(%)</span></label>
                <input type="number" id="createMaxCpu" name="maxCpu" min="10" max="10000" placeholder="<%= t('useGlobalDefault') %>" class="al-input">
              </div>
              <div>
                <label class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%- icon('database', { size: 14, class: 'shrink-0' }) %> <%= t('maxStorage') %></label>
                <input type="hidden" id="createMaxStorage" name="maxStorage">
                <div class="flex items-stretch gap-0">
                  <input type="number" id="createMaxStorageDisplay" min="1" max="10000" placeholder="<%= t('useGlobalDefault') %>"
                    class="al-input rounded-l-xl flex-1 border-r-0">
                  <button type="button" class="al-format-switcher" data-format-switcher
                    data-display="createMaxStorageDisplay" data-hidden="createMaxStorage"
                    data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
                </div>
              </div>
              <div>
                <label class="flex items-center gap-1.5 text-sm font-medium mb-2" style="color:var(--theme-text-strong)"><%- icon('server', { size: 14, class: 'shrink-0' }) %> <%= t('maxDatabases') %></label>
                <input type="number" id="createMaxDatabases" name="maxDatabases" min="0" max="100000" placeholder="<%= t('useGlobalDefault') %>" class="al-input">
                <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('totalDatabasesAcrossAllServers') %></p>
              </div>
            </div>
          </div>

          <div class="flex justify-end gap-2">
            <a href="/admin/users" class="al-btn-secondary"><%= t('cancel') %></a>
            <button type="submit" id="createUserSubmitBtn" class="al-btn-primary">
              <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
              <span id="createUserSubmitText"><%= t('createUser') %></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>


<style>
#createUserForm .al-card-header { border-radius: 12px 12px 0 0; overflow: hidden; margin-bottom: 16px; }
</style>

<script nonce="<%- nonce %>">
(function() {
  let saving = false;
  const errorEl = document.getElementById('createUserError');
  const submitBtn = document.getElementById('createUserSubmitBtn');
  const submitText = document.getElementById('createUserSubmitText');
  const usernameInput = document.getElementById('userUsername');
  const passwordInput = document.getElementById('userPassword');
  const isAdminToggle = document.getElementById('createIsAdmin');
  const isAdminLabel = document.getElementById('createIsAdminLabel');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  function hideError() {
    errorEl.classList.add('hidden');
    errorEl.textContent = '';
  }

  function validateUsername() {
    const v = usernameInput.value;
    const lenOk = v.length >= 3 && v.length <= 32;
    const charsOk = /^[a-zA-Z0-9]+$/.test(v);
    const lenEl = document.getElementById('username-len-crit');
    const charsEl = document.getElementById('username-chars-crit');
    if (lenEl) {
      lenEl.className = 'text-xs ' + (lenOk ? 'text-green-500' : (v ? 'text-red-500' : 'text-neutral-400'));
      lenEl.querySelector('.crit-icon').textContent = lenOk ? '✓' : (v ? '✗' : '—');
    }
    if (charsEl) {
      charsEl.className = 'text-xs ' + (charsOk ? 'text-green-500' : (v ? 'text-red-500' : 'text-neutral-400'));
      charsEl.querySelector('.crit-icon').textContent = charsOk ? '✓' : (v ? '✗' : '—');
    }
    return lenOk && charsOk;
  }

  function validatePassword() {
    const v = passwordInput.value;
    const lenOk = v.length >= 8;
    const letterOk = /[A-Za-z]/.test(v);
    const numberOk = /\d/.test(v);
    const lenEl = document.getElementById('pw-len-crit');
    const letterEl = document.getElementById('pw-letter-crit');
    const numberEl = document.getElementById('pw-number-crit');
    if (lenEl) {
      lenEl.className = 'text-xs ' + (lenOk ? 'text-green-500' : (v ? 'text-red-500' : 'text-neutral-400'));
      lenEl.querySelector('.crit-icon').textContent = lenOk ? '✓' : (v ? '✗' : '—');
    }
    if (letterEl) {
      letterEl.className = 'text-xs ' + (letterOk ? 'text-green-500' : (v ? 'text-red-500' : 'text-neutral-400'));
      letterEl.querySelector('.crit-icon').textContent = letterOk ? '✓' : (v ? '✗' : '—');
    }
    if (numberEl) {
      numberEl.className = 'text-xs ' + (numberOk ? 'text-green-500' : (v ? 'text-red-500' : 'text-neutral-400'));
      numberEl.querySelector('.crit-icon').textContent = numberOk ? '✓' : (v ? '✗' : '—');
    }
    return lenOk && letterOk && numberOk;
  }

  usernameInput.addEventListener('input', validateUsername);
  passwordInput.addEventListener('input', validatePassword);
  isAdminToggle.addEventListener('change', function() {
    isAdminLabel.textContent = this.checked ? '<%= t('enabled') %>' : '<%= t('disabled') %>';
  });

  window.submitUserCreate = async function() {
    if (saving) return;
    hideError();

    const email = document.getElementById('userEmail').value;
    const username = usernameInput.value;
    const password = passwordInput.value;
    const confirmPassword = document.getElementById('userConfirmPassword').value;

    if (!email || !username || !password) {
      showError('<%= t('createUserAllFieldsRequired') %>');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('<%= t('createUserInvalidEmail') %>');
      return;
    }
    if (!validateUsername()) {
      showError('<%= t('createUserInvalidUsername') %>');
      return;
    }
    if (!validatePassword()) {
      showError('<%= t('createUserInvalidPassword') %>');
      return;
    }

    saving = true;
    submitBtn.disabled = true;
    submitText.textContent = '<%= t('creating') %>';
    const loader = showProgressToast('<%= t('createUserProcessing') %>');
    loader.setStage('<%= t('createUserSending') %>');

    try {
      const maxMemoryDisplay = document.getElementById('createMaxMemoryDisplay').value;
      const maxMemoryHidden = document.getElementById('createMaxMemory').value;
      const maxStorageDisplay = document.getElementById('createMaxStorageDisplay').value;
      const maxStorageHidden = document.getElementById('createMaxStorage').value;

      const limits = {
        serverLimit: parseInt(document.getElementById('createServerLimit').value) || null,
        maxCpu: parseInt(document.getElementById('createMaxCpu').value) || null,
        maxDatabases: parseInt(document.getElementById('createMaxDatabases').value) || null,
        maxMemory: maxMemoryDisplay !== '' ? parseInt(maxMemoryDisplay, 10) : (maxMemoryHidden !== '' ? parseInt(maxMemoryHidden, 10) : null),
        maxStorage: maxStorageDisplay !== '' ? parseInt(maxStorageDisplay, 10) : (maxStorageHidden !== '' ? parseInt(maxStorageHidden, 10) : null),
      };

      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      const res = await fetch('/api/v2/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        body: JSON.stringify({
          email, username, password,
          role: document.getElementById('createRole').value,
          isAdmin: isAdminToggle.checked, ...limits
        }),
      });
      if (res.ok) {
        loader.complete(true, '<%= t('createUserAdded') %>');
        setTimeout(() => { window.location.href = '/admin/users?err=none'; }, 1000);
      } else {
        const err = await res.json().catch(() => ({ message: 'Unknown error' }));
        loader.close();
        showError(err.message || '<%= t('createUserFailed') %>');
      }
    } catch (e) {
      loader.close();
      showError('<%= t('createUserNetworkError') %>');
    } finally {
      saving = false;
      submitBtn.disabled = false;
      submitText.textContent = '<%= t('createUser') %>';
    }
  };
})();
</script>

<%- include('../../components/footer') %>
