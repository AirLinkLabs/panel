<%- include('../../layouts/admin', { title: t('adminEditUserTitle') }) %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbUsers'), url: '/admin/users' },
    { label: t('edit') }
  ] }) %>

  <div class="flex items-start justify-between gap-4 mt-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= t('adminEditUserTitle') %></h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('adminEditUserText') %></p>
    </div>
    <div class="flex gap-2 shrink-0 items-center">
      <a href="/admin/users" class="al-btn-secondary"><%= t('backToUsers') %></a>
      <button type="submit" form="editUserForm" class="al-btn-primary">
        <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
        <span><%= t('save') %></span>
      </button>
    </div>
  </div>

  <div class="mt-5 space-y-5">
    <div id="editUserError" class="hidden rounded-xl px-4 py-3 text-sm" style="background:var(--theme-danger-bg);border:1px solid color-mix(in srgb, var(--theme-danger) 25%, transparent);color:var(--theme-danger)"></div>
    <form id="editUserForm" onsubmit="event.preventDefault(); submitUserEdit()" class="space-y-5">
      <%- include('../../partials/csrf') %>

      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('userInformation') %></h2>
        </div>
        <div class="al-card-body">
          <div class="flex items-center gap-4 mb-5 pb-5 border-b" style="border-color:var(--theme-border)">
            <img class="h-12 w-12 rounded-xl object-cover shrink-0 border" style="border-color:var(--theme-border)" src="<%= dataUser.avatar ? dataUser.avatar : '/avatar/' + encodeURIComponent(dataUser.username) %>" alt="<%= dataUser.username %>">
            <div>
              <p class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= dataUser.username %></p>
              <p class="text-xs" style="color:var(--theme-text-muted)"><%= dataUser.email %></p>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="al-form-field">
              <label for="username" class="al-form-label">
                <%- icon('user', { size: 14, class: 'shrink-0' }) %> <%= t('username') %>
              </label>
              <input type="text" id="editUsername" name="username" value="<%= dataUser.username %>" class="al-form-input" required>
            </div>
            <div class="al-form-field">
              <label for="email" class="al-form-label">
                <%- icon('mail', { size: 14, class: 'shrink-0' }) %> <%= t('email') %>
              </label>
              <input type="email" id="editEmail" name="email" value="<%= dataUser.email %>" class="al-form-input" required>
            </div>
            <div class="md:col-span-2 al-form-field">
              <label for="description" class="al-form-label"><%= t('description') %></label>
              <textarea id="editDescription" name="description" rows="3" class="al-form-textarea"><%= dataUser.description || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('security') %></h2>
        </div>
        <div class="al-card-body">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="al-form-field">
              <label for="password" class="al-form-label">
                <%- icon('lock', { size: 14, class: 'shrink-0' }) %>
                <%= t('newPassword') %> <span class="text-xs" style="color:var(--theme-text-muted)">(<%= t('leaveBlankToKeep') %>)</span>
              </label>
              <input type="password" id="editPassword" name="password" class="al-form-input">
            </div>
            <div class="al-form-field">
              <label for="confirmPassword" class="al-form-label"><%= t('confirmPassword') %></label>
              <input type="password" id="editConfirmPassword" name="confirmPassword" class="al-form-input">
            </div>
            <div class="md:col-span-2">
              <div class="p-4 rounded-xl border" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('role') %></h3>
                    <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('roleDescription') %></p>
                  </div>
                  <select id="editRole" name="role" class="al-form-select w-44" <%= dataUser.role === 'owner' ? 'disabled' : '' %>>
                    <option value="user" <%= dataUser.role === 'user' ? 'selected' : '' %>><%= t('roleDisplayNameUser') %></option>
                    <option value="privileged" <%= dataUser.role === 'privileged' ? 'selected' : '' %>><%= t('roleDisplayNamePrivileged') %></option>
                    <option value="admin" <%= dataUser.role === 'admin' ? 'selected' : '' %>><%= t('roleDisplayNameAdmin') %></option>
                    <option value="owner" <%= dataUser.role === 'owner' ? 'selected' : '' %> disabled><%= t('roleDisplayNameOwner') %></option>
                  </select>
                </div>
                <% if (dataUser.role === 'owner') { %>
                  <p class="text-xs mt-2" style="color:var(--theme-text-muted)"><%= t('ownerRoleCannotBeChanged') %></p>
                <% } %>
              </div>
            </div>
            <div class="md:col-span-2">
              <div class="p-4 rounded-xl border" style="background:var(--theme-bg-secondary);border-color:var(--theme-border)">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium" style="color:var(--theme-text-strong)"><%= t('adminStatus') %></h3>
                    <p class="text-xs mt-1" style="color:var(--theme-text-muted)"><%= t('adminDescription') %></p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer shrink-0">
                    <input type="checkbox" id="editIsAdmin" name="isAdmin" class="sr-only peer" <%= dataUser.isAdmin ? 'checked' : '' %> <% if (dataUser.role === 'owner') { %>disabled<% } %>>
                    <div class="al-toggle-track"><div class="al-toggle-dot"></div></div>
                    <span id="editIsAdminLabel" class="ms-3 text-sm font-medium" style="color:var(--theme-text-strong)"><%= dataUser.isAdmin ? t('enabled') : t('disabled') %></span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="al-card">
        <div class="al-card-header">
          <h2 class="al-card-title"><%= t('serverLimits') %></h2>
        </div>
        <div class="al-card-body">
          <p class="text-xs mb-4" style="color:var(--theme-text-muted)"><%= t('leaveBlankForDefaults') %></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="al-form-field">
              <label class="al-form-label"><%- icon('sliders-horizontal', { size: 14, class: 'shrink-0' }) %> <%= t('serverLimit') %></label>
              <input type="number" id="editServerLimit" name="serverLimit" min="0" max="100" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input" value="<%= dataUser.serverLimit ?? '' %>">
              <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('maxServersThisUserCanCreate') %></p>
            </div>
            <div class="al-form-field">
              <label class="al-form-label"><%- icon('memory-stick', { size: 14, class: 'shrink-0' }) %> <%= t('maxMemory') %></label>
              <input type="hidden" id="editMaxMemory" name="maxMemory" value="<%= dataUser.maxMemory ?? '' %>">
              <div class="flex items-stretch gap-0">
                <input type="number" id="editMaxMemoryDisplay" min="128" max="65536" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input rounded-l-xl flex-1 border-r-0" value="<%= dataUser.maxMemory ?? '' %>">
                <button type="button" class="al-format-switcher" data-format-switcher data-display="editMaxMemoryDisplay" data-hidden="editMaxMemory" data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
              </div>
            </div>
            <div class="al-form-field">
              <label class="al-form-label"><%- icon('cpu', { size: 14, class: 'shrink-0' }) %> <%= t('maxCpu') %> <span class="font-normal text-xs" style="color:var(--theme-text-muted)"> (%)</span></label>
              <input type="number" id="editMaxCpu" name="maxCpu" min="10" max="10000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input" value="<%= dataUser.maxCpu ?? '' %>">
            </div>
            <div class="al-form-field">
              <label class="al-form-label"><%- icon('database', { size: 14, class: 'shrink-0' }) %> <%= t('maxStorage') %></label>
              <input type="hidden" id="editMaxStorage" name="maxStorage" value="<%= dataUser.maxStorage ?? '' %>">
              <div class="flex items-stretch gap-0">
                <input type="number" id="editMaxStorageDisplay" min="1" max="10000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input rounded-l-xl flex-1 border-r-0" value="<%= dataUser.maxStorage ?? '' %>">
                <button type="button" class="al-format-switcher" data-format-switcher data-display="editMaxStorageDisplay" data-hidden="editMaxStorage" data-units="1:MB,1024:GB" data-default-unit="MB">MB</button>
              </div>
            </div>
            <div class="al-form-field">
              <label class="al-form-label"><%- icon('server', { size: 14, class: 'shrink-0' }) %> <%= t('maxDatabases') %></label>
              <input type="number" id="editMaxDatabases" name="maxDatabases" min="0" max="100000" placeholder="<%= t('useGlobalDefault') %>" class="al-form-input" value="<%= dataUser.maxDatabases ?? '' %>">
              <p class="mt-1 text-xs" style="color:var(--theme-text-muted)"><%= t('totalDatabasesAcrossAllServers') %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <a href="/admin/users" class="al-btn-secondary"><%= t('cancel') %></a>
        <button type="submit" id="editUserSubmitBtn" class="al-btn-primary">
          <%- icon('save', { class: 'size-4', strokeWidth: 1.5 }) %>
          <span id="editUserSubmitText"><%= t('save') %></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script nonce="<%- nonce %>">
(function() {
  var userId = <%= dataUser.id %>;
  var saving = false;
  var errorEl = document.getElementById('editUserError');
  var isAdminToggle = document.getElementById('editIsAdmin');
  var isAdminLabel = document.getElementById('editIsAdminLabel');

  isAdminToggle.addEventListener('change', function() {
    isAdminLabel.textContent = this.checked ? '<%= t('enabled') %>' : '<%= t('disabled') %>';
  });

  window.submitUserEdit = async function() {
    if (saving) return;
    errorEl.classList.add('hidden');
    errorEl.textContent = '';

    var password = document.getElementById('editPassword').value;
    var confirmPassword = document.getElementById('editConfirmPassword').value;

    if (password && password !== confirmPassword) {
      errorEl.textContent = '<%= t('passwordsDoNotMatch') || 'Passwords do not match' %>';
      errorEl.classList.remove('hidden');
      return;
    }

    saving = true;

    try {
      var maxMemoryDisplay = document.getElementById('editMaxMemoryDisplay').value;
      var maxMemoryHidden = document.getElementById('editMaxMemory').value;
      var maxStorageDisplay = document.getElementById('editMaxStorageDisplay').value;
      var maxStorageHidden = document.getElementById('editMaxStorage').value;

      var data = {
        username: document.getElementById('editUsername').value,
        email: document.getElementById('editEmail').value,
        description: document.getElementById('editDescription').value,
        role: document.getElementById('editRole').value,
        isAdmin: isAdminToggle.checked,
        password: password || undefined,
        serverLimit: parseInt(document.getElementById('editServerLimit').value) || null,
        maxMemory: maxMemoryDisplay !== '' ? parseInt(maxMemoryDisplay, 10) : (maxMemoryHidden !== '' ? parseInt(maxMemoryHidden, 10) : null),
        maxCpu: parseInt(document.getElementById('editMaxCpu').value) || null,
        maxStorage: maxStorageDisplay !== '' ? parseInt(maxStorageDisplay, 10) : (maxStorageHidden !== '' ? parseInt(maxStorageHidden, 10) : null),
        maxDatabases: parseInt(document.getElementById('editMaxDatabases').value) || null,
      };

      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
      var res = await fetch('/admin/users/update/' + userId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify(data),
      });

      var result = await res.json();
      if (!res.ok || result.error) {
        errorEl.textContent = result.error || result.message || '<%= t('errorUpdatingUser') %>';
        errorEl.classList.remove('hidden');
      } else {
        window.location.href = '/admin/users';
      }
    } catch (e) {
      errorEl.textContent = '<%= t('errorUpdatingUser') %>';
      errorEl.classList.remove('hidden');
    } finally {
      saving = false;
    }
  };
})();
</script>

<%- include('../../layouts/admin-footer') %>
