<%- include('../../layouts/admin', { title: t('adminUserTitle') }) %>

<div class="px-4 sm:px-6 lg:px-8 pt-4">
  <%- include('../../partials/ui/breadcrumb', { items: [
    { label: t('admin'), url: '/admin/overview' },
    { label: t('breadcrumbUsers'), url: '/admin/users' },
    { label: t('adminUserTitle') }
  ] }) %>

  <div class="flex items-start justify-between gap-4 mt-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight" style="color:var(--theme-text-strong)"><%= t('adminUserTitle') %></h1>
      <p class="text-sm mt-1" style="color:var(--theme-text-muted)"><%= t('adminUserText') %></p>
    </div>
    <div class="flex gap-2 shrink-0 items-center">
      <a href="/admin/users/edit/<%= dataUser.id %>" class="al-btn-primary">
        <%- icon('pencil', { size: 16 }) %>
        <span><%= t('editUser') %></span>
      </a>
    </div>
  </div>

  <div class="mt-5">
    <div class="rounded-xl p-6 shadow-lg border" style="background:var(--theme-bg-card);border-color:var(--theme-border)">
      <div class="flex items-center gap-4 mb-6 pb-6 border-b" style="border-color:var(--theme-border)">
        <img class="h-16 w-16 rounded-xl object-cover shrink-0 border" style="border-color:var(--theme-border)" src="<%= dataUser.avatar ? dataUser.avatar : '/avatar/' + encodeURIComponent(dataUser.username) %>" alt="<%= dataUser.username %>">
        <div>
          <p class="text-base font-semibold" style="color:var(--theme-text-strong)"><%= dataUser.username %></p>
          <p class="text-sm" style="color:var(--theme-text-muted)"><%= dataUser.email %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h2 class="text-lg font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)">
            <%= t('userInformation') %>
          </h2>
          <div class="space-y-4">
            <div>
              <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('username') %></p>
              <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.username %></p>
            </div>
            <div>
              <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('email') %></p>
              <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.email %></p>
            </div>
            <div>
              <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('role') %></p>
              <p class="mt-1">
                <% var roleLabel = dataUser.role || (dataUser.isAdmin ? 'admin' : 'user'); %>
                <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset"
                  style="<%= ['owner','admin'].includes(roleLabel) ? 'background:var(--theme-success-bg);color:var(--theme-success)' : roleLabel === 'privileged' ? 'background:var(--theme-info-bg);color:var(--theme-info)' : 'background:var(--theme-warning-bg);color:var(--theme-warning)' %>">
                  <%= roleLabel.charAt(0).toUpperCase() + roleLabel.slice(1) %>
                </span>
              </p>
            </div>
            <div>
              <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('description') %></p>
              <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser.description || t('noDescriptionProvided') %></p>
            </div>
          </div>
        </div>
        <div>
          <h2 class="text-lg font-medium border-b pb-2 mb-4" style="color:var(--theme-text-strong);border-color:var(--theme-border)">
            <%= t('serverInformation') %>
          </h2>
          <div class="space-y-4">
            <div>
              <p class="text-sm font-medium" style="color:var(--theme-text-muted)"><%= t('totalServers') %></p>
              <p class="mt-1 text-base font-medium" style="color:var(--theme-text-strong)"><%= dataUser._count ? dataUser._count.servers : 0 %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../layouts/admin-footer') %>
