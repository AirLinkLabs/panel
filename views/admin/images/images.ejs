<%- include('../../components/header', { title: t('adminImagesTitle') }) %>

<style>
  ::-webkit-scrollbar { display: none; }
</style>

<main class="min-h-screen m-auto">
  <div class="flex min-h-screen">
    <div class="hidden lg:block w-60 shrink-0"><%- include('../../components/sidebar') %></div>
<%- include('../../components/template') %>
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">

      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('breadcrumbImages') }
      ] }) %>

      <div class="al-page-header flex items-start justify-between gap-4">
        <div>
          <h1 class="al-page-title"><%= t('images') %></h1>
          <p class="al-page-desc"><%= t('adminImagesText') %></p>
        </div>
        <div class="flex gap-2 shrink-0">
          <button onclick="imageManagerState.openUploadImageModal()" type="button" class="al-btn-secondary"><%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('uploadJson') %></button>
          <button onclick="imageManagerState.openCreate()" type="button" class="al-btn-secondary"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('newImage') %></button>
          <a href="/admin/images#store" class="al-btn-secondary"><%= t('browseStore') %></a>
        </div>
      </div>

      <div class="al-page-body" data-al-tabs data-tabs-default="installed" data-tabs-hash>
      <div role="tablist" class="flex gap-1 mb-6">
        <button type="button" id="tab-btn-installed" data-tab="installed" role="tab" aria-selected="true" tabindex="0" aria-controls="tab-panel-installed" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('box', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('installed') %> <span id="tabCountInstalled" class="ml-1 text-xs" style="color:var(--theme-text-muted)"><%= images.length %></span></button>
        <button type="button" id="tab-btn-approvals" data-tab="approvals" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-approvals" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('clock', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('approvals') %> <% if (pending && pending.length > 0) { %><span id="tabCountApprovals" class="ml-1 text-xs font-semibold" style="color:var(--theme-warning);"><%= pending.length %></span><% } %></button>
        <button type="button" id="tab-btn-store" data-tab="store" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-store" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('storeTab') %></button>
      </div>

      <div id="tab-panel-installed" role="tabpanel" aria-labelledby="tab-btn-installed" data-tab-panel="installed" class="mt-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="text-sm" style="color:var(--theme-text-muted);"><span id="installedImagesCount"><%= images.length %></span> <%= t('imagesInstalled') %></div>
        </div>

      <div id="installedEmptyState" class="flex flex-col items-center justify-center py-24 text-center <%= images.length === 0 ? '' : 'hidden' %>">
        <p class="text-sm" style="color:var(--theme-text-muted)"><%= t('noImagesInstalled') %></p>
        <a href="/admin/images#store" class="mt-4 al-btn-secondary inline-flex items-center gap-1.5"><%- icon('store', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('browseStore') %></a>
      </div>

      <%- include('../../fragments/admin/images/image-table', { images, settings, req }) %>
      </div>

      <div id="tab-panel-approvals" role="tabpanel" aria-labelledby="tab-btn-approvals" data-tab-panel="approvals" hidden>
        <%- include('../../fragments/admin/images/pending-approvals', { pending, settings, req }) %>
      </div>

      <div id="tab-panel-store" role="tabpanel" aria-labelledby="tab-btn-store" data-tab-panel="store" hidden>
        <%- include('store-panel') %>
      </div>
      </div>
    </div>
  </div>
</main>

<!-- Reject modal -->
<div id="rejectModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('rejectImage') %></h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)" id="rejectName"></p>
      </div>
      <button type="button" class="al-btn-ghost p-2 rounded-lg flex items-center justify-center shrink-0" onclick="imageManagerState.closeRejectModal()" aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="px-6 py-4">
      <label class="al-label" for="rejectReason"><%= t('reason') %> <span class="font-normal" style="color:var(--theme-text-muted)"><%= t('reasonHint') %></span></label>
      <textarea id="rejectReasonInput" class="al-input w-full" rows="3" placeholder="e.g. Missing startup exit detection or required docker image."></textarea>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" class="al-btn-secondary px-4 py-2 text-xs font-medium" onclick="imageManagerState.closeRejectModal()"><%= t('cancel') %></button>
      <button type="button" id="rejectConfirmBtn" class="al-btn-danger px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3.5', strokeWidth: 1.5 }) %><span id="rejectConfirmLabel"><%= t('reject') %></span>
      </button>
    </div>
  </div>
</div>

<script nonce="<%- nonce %>">
var imageRejectState = { rejectId: null };

function openRejectModal(id, name) {
  imageRejectState.rejectId = id;
  document.getElementById('rejectName').textContent = name;
  document.getElementById('rejectReasonInput').value = '';
  document.getElementById('rejectModal').classList.remove('opacity-0', 'pointer-events-none');
}

function closeRejectModal() {
  document.getElementById('rejectModal').classList.add('opacity-0', 'pointer-events-none');
  imageRejectState.rejectId = null;
}

document.addEventListener('DOMContentLoaded', function() {
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !document.getElementById('rejectModal').classList.contains('pointer-events-none')) {
      closeRejectModal();
    }
  });
  document.getElementById('rejectConfirmBtn').addEventListener('click', async function() {
    if (imageRejectState.rejectId == null) return;
    var id = imageRejectState.rejectId;
    var reason = document.getElementById('rejectReasonInput').value;
    var btn = this;
    btn.disabled = true;
    document.getElementById('rejectConfirmLabel').textContent = '<%= t('rejecting') %>';
    try {
      var res = await fetch('/api/v2/admin/images/' + id + '/reject', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason }),
      });
      var data = await res.json();
      closeRejectModal();
      if (data.error) { showToast(data.error, 'error'); }
      else { showToast(data.message || window.__i18n.imageRejected || 'Image rejected.', 'success'); window.location.reload(); }
    } catch (e) { closeRejectModal(); showToast(window.__i18n.somethingWentWrong || 'Something went wrong.', 'error'); }
    finally { btn.disabled = false; document.getElementById('rejectConfirmLabel').textContent = '<%= t('reject') %>'; }
  });
});
</script>

<div id="page-data" style="display:none"
  data-approve-confirm="Approve this image? It will become available to all users."
  data-approved="Image approved."
  data-rejected="Image rejected."
  data-error="Something went wrong."
></div>

<!-- Upload modal -->
<div id="uploadImageModal" class="al-sheet-overlay fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  <div id="uploadImageModalPanel" class="al-sheet-panel rounded-2xl max-w-md w-full will-change-transform shadow-xl max-h-[85vh] flex flex-col" style="background:var(--theme-bg-card); border:1px solid var(--theme-border);">
    <div class="al-sheet-header" style="border-color:var(--theme-border)">
      <div>
        <h2 class="text-sm font-semibold" style="color:var(--theme-text-strong)"><%= t('uploadImage') %></h2>
        <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('uploadImageDesc') %></p>
      </div>
      <button type="button" onclick="imageManagerState.closeUploadImageModal()" class="al-btn-ghost p-2 rounded-lg min-w-[44px] min-h-[44px] flex items-center justify-center shrink-0" aria-label="<%= t('ariaClose') %>">
        <%- icon('x', { class: 'h-5 w-5', strokeWidth: 1.5 }) %>
      </button>
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4">
      <div class="flex gap-1 p-1 rounded-xl mb-4" style="background:var(--theme-bg-secondary)">
        <button type="button" id="uploadModeFile" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)]" style="color:var(--theme-text-strong); background:var(--theme-bg-card);"><%= t('uploadFile') %></button>
        <button type="button" id="uploadModeUrl" class="flex-1 px-3 py-2 text-xs font-medium rounded-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-border-accent)]" style="color:var(--theme-text-muted);"><%= t('importFromUrl') %></button>
      </div>
      <div id="uploadFileSection">
        <div class="mb-4">
          <label for="imageFileInput" class="w-full px-3 py-6 border-2 border-dashed rounded-xl focus:outline-none focus:ring-2 transition text-center cursor-pointer block" id="imageDropZone" style="border-color:var(--theme-border); color:var(--theme-text-strong);">
            <%- icon('upload', { class: 'w-10 h-10 mx-auto mb-2', fill: 'currentColor', strokeWidth: 1 }) %>
            <p style="color:var(--theme-text-muted)"><%= t('dragDropJson') %></p>
          </label>
          <input type="file" id="imageFileInput" class="hidden" accept=".json">
        </div>
      <div id="imageFilePreview" class="hidden">
        <div class="flex items-center p-3 rounded-xl" style="background:var(--theme-bg-secondary);">
          <%- icon('file-json', { class: 'w-6 h-6 mr-3', style: 'color:var(--theme-text-muted)' }) %>
          <div class="flex-1 truncate">
            <p id="imageSelectedFileName" class="font-medium truncate" style="color:var(--theme-text-strong)"></p>
            <p id="imageSelectedFileSize" class="text-sm" style="color:var(--theme-text-muted)"></p>
          </div>
          <button type="button" onclick="imageManagerState.removeSelectedImageFile()" class="ml-2" aria-label="<%= t('ariaRemoveSelectedFile') %>" style="color:var(--theme-text-muted)">
            <%- icon('x', { class: 'w-5 h-5' }) %>
          </button>
        </div>
      </div>
      </div>
      <div id="importUrlSection" class="hidden">
        <label class="al-label" for="importUrlInput"><%= t('imageUrl') %></label>
        <input id="importUrlInput" type="url" placeholder="https://raw.githubusercontent.com/…/egg.json" class="al-input w-full">
        <p class="mt-2 text-xs" style="color:var(--theme-text-muted)"><%= t('importUrlDesc') %></p>
      </div>
    </div>
    <div class="al-sheet-footer justify-end" style="border-color:var(--theme-border)">
      <button type="button" onclick="imageManagerState.closeUploadImageModal()" class="al-btn-secondary px-4 py-2 text-xs font-medium inline-flex items-center gap-2">
        <%- icon('x', { class: 'size-3', strokeWidth: 1.5 }) %>
        <%= t('cancel') %>
      </button>
      <button type="button" id="imageUploadButton" class="al-btn-primary px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5" disabled>
        <%- icon('upload', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('upload') %>
      </button>
      <button type="button" id="importUrlSubmit" class="al-btn-primary hidden px-3 py-2 text-sm font-medium inline-flex items-center gap-1.5">
        <%- icon('download', { class: 'size-4', strokeWidth: 1.5 }) %>
        <%= t('fetchAndImport') %>
      </button>
    </div>
  </div>
</div>

<!-- Create content — hosted inside the shared window.modal shell -->
<div id="createContent" style="display:none;">
  <form onsubmit="submitCreateImage(event); return false;" class="flex flex-col gap-4">
      <div class="grid grid-cols-2 gap-3">
      <div class="col-span-2"><label class="al-label"><%= t('name') %> <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="name" required placeholder="e.g. Minecraft Java"></div>
      <div><label class="al-label"><%= t('author') %></label><input class="al-input" type="text" name="author" placeholder="e.g. github.com/you"></div>
      <div><label class="al-label"><%= t('authorName') %></label><input class="al-input" type="text" name="authorName" placeholder="Your Name"></div>
      <div class="col-span-2"><label class="al-label"><%= t('startupCommand') %> <span style="color:var(--theme-danger)">*</span></label><input class="al-input" type="text" name="startup" required placeholder="java -Xms128M -jar server.jar" style="font-family:ui-monospace,monospace;font-size:12px;"></div>
      <div class="col-span-2"><label class="al-label"><%= t('description') %></label><textarea class="al-input" name="description" rows="2" placeholder="<%= t('imageDescriptionPlaceholder') %>" style="resize:none;"></textarea></div>
    </div>
    <div class="flex gap-2 pt-1">
      <button type="button" onclick="imageManagerState.closeCreate()" class="flex-1 py-2 rounded-xl border text-sm font-medium hover:bg-[var(--theme-bg-hover)] transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);color:var(--theme-text)"><%- icon('x', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('cancel') %></button>
      <button type="submit" class="flex-1 py-2 rounded-xl border text-sm font-medium shadow-lg hover:bg-[var(--theme-bg-hover)] transition inline-flex items-center justify-center gap-1.5" style="border-color:var(--theme-border);background:var(--theme-bg-card);color:var(--theme-text-strong)"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('createAndEdit') %></button>
    </div>
  </form>
</div>

<script nonce="<%- nonce %>">
function imageManager() {
  let _deleteId = null;

  function esc(str) {
    return String(str == null ? "" : str).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function imageRowHtml(image) {
    return '<tr class="al-table-tr transition-colors cursor-pointer img-row" data-search="' +
      esc((image.name + " " + (image.author || "")).toLowerCase()) +
      '" onclick="imageManagerState.handleRowClick(event, \'/admin/images/edit/' + image.id + '\')">' +
      '<td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3 font-medium" style="color:var(--theme-text-strong)">' + esc(image.name) + '</td>' +
      '<td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">' + esc(image.author || "—") + '</td>' +
      '<td class="al-table-td whitespace-nowrap px-3 py-4 col-hide">' + esc(new Date(image.createdAt).toLocaleDateString()) + '</td>' +
      '<td class="whitespace-nowrap px-3 py-4 text-sm"><div class="flex gap-2">' +
      '<a href="/admin/images/edit/' + image.id + '" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5">' + (window.alIcon ? alIcon("pencil", "size-4") : "") + (window.__i18n.edit || 'Edit') + '</a>' +
      '<a href="/admin/images/export/' + image.id + '" onclick="event.stopPropagation()" class="al-btn-secondary px-3 py-2 text-sm font-medium shadow-lg transition inline-flex items-center gap-1.5">' + (window.alIcon ? alIcon("download", "size-4") : "") + (window.__i18n.export || 'Export') + '</a>' +
      '<button onclick="event.stopPropagation(); openDelete(\'' + image.id + '\', \'' + esc(image.name).replace(/\\/g, '\\\\').replace(/'/g, "\\'") + '\')" type="button" class="al-btn-danger" aria-label="' + (window.__i18n.deleteImage || 'Delete image') + ' ' + esc(image.name) + '">' + (window.alIcon ? alIcon("trash-2", "size-4") : "") + '</button>' +
      '</div></td></tr>';
  }

  function formatImageFileSize(bytes) {
    if (bytes === 0) return "0 Bytes";
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return parseFloat((bytes / Math.pow(1024, i)).toFixed(2)) + " " + sizes[i];
  }

  function setUploadMode(mode) {
    const isUrl = mode === "url";
    const fileBtn = document.getElementById("uploadModeFile");
    const urlBtn = document.getElementById("uploadModeUrl");
    const fileSection = document.getElementById("uploadFileSection");
    const urlSection = document.getElementById("importUrlSection");
    const uploadBtn = document.getElementById("imageUploadButton");
    const submitBtn = document.getElementById("importUrlSubmit");
    const active = "color:var(--theme-text-strong); background:var(--theme-bg-card);";
    const idle = "color:var(--theme-text-muted);";
    if (fileBtn) fileBtn.setAttribute("style", isUrl ? idle : active);
    if (urlBtn) urlBtn.setAttribute("style", isUrl ? active : idle);
    if (fileSection) fileSection.classList.toggle("hidden", isUrl);
    if (urlSection) urlSection.classList.toggle("hidden", !isUrl);
    if (uploadBtn) uploadBtn.classList.toggle("hidden", isUrl);
    if (submitBtn) submitBtn.classList.toggle("hidden", !isUrl);
  }

  return {
    init() {
      const self = this;
      window.submitCreateImage = (e) => self.submitCreateImage(e);
      window.openDelete = (id, name) => self.openDelete(id, name);
      window.removeSelectedImageFile = () => self.removeSelectedImageFile();
      setUploadMode("file");
      const dropZone = document.getElementById("imageDropZone");
      const fileInput = document.getElementById("imageFileInput");
      const uploadButton = document.getElementById("imageUploadButton");
      if (dropZone) {
        dropZone.addEventListener("dragover", function (e) {
          e.preventDefault();
          dropZone.style.background = "var(--theme-bg-hover)";
          dropZone.style.borderColor = "var(--theme-accent)";
        });
        dropZone.addEventListener("dragleave", function (e) {
          e.preventDefault();
          dropZone.style.background = "";
          dropZone.style.borderColor = "var(--theme-border)";
        });
        dropZone.addEventListener("drop", (e) => {
          e.preventDefault();
          dropZone.style.background = "";
          dropZone.style.borderColor = "var(--theme-border)";
          if (e.dataTransfer.files.length > 0) this.handleImageFileSelection(e.dataTransfer.files[0]);
        });
      }
      if (fileInput) {
        fileInput.addEventListener("change", (e) => {
          if (e.target.files.length > 0) this.handleImageFileSelection(e.target.files[0]);
        });
      }
      if (uploadButton) {
        uploadButton.addEventListener("click", () => this.confirmImageUpload());
      }
      const importUrlSubmit = document.getElementById("importUrlSubmit");
      if (importUrlSubmit) {
        importUrlSubmit.addEventListener("click", async () => {
          const url = document.getElementById("importUrlInput").value.trim();
          if (!url) { showToast(window.__i18n.enterUrl || "Enter a URL.", "error"); return; }
          const btn = importUrlSubmit;
          btn.disabled = true; btn.classList.add("opacity-60");
          try {
            const r = await fetch("/api/v2/admin/images/import-url", {
              method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ url }),
            });
            const d = await r.json();
            if (r.ok && d.success) {
              showToast(d.message || (window.__i18n.imageImported || "Image imported."), "success");
              window.location.reload();
            } else { showToast((d.error?.message) || (window.__i18n.importFailed || "Import failed."), "error"); }
          } catch { showToast(window.__i18n.importFailed || "Import failed.", "error"); }
          finally { btn.disabled = false; btn.classList.remove("opacity-60"); }
        });
      }
      document.getElementById("uploadModeFile").addEventListener("click", () => setUploadMode("file"));
      document.getElementById("uploadModeUrl").addEventListener("click", () => {
        setUploadMode("url");
        document.getElementById("importUrlInput").focus();
      });
    },
    handleRowClick(e, url) {
      if (!e.target.closest("button,a")) window.location.href = url;
    },
    openCreate() {
      window.modal.show({
        title: window.__i18n.newImage || "New Image",
        bodyNode: document.getElementById("createContent"),
        panelClass: "max-w-xl",
      });
    },
    closeCreate() { window.modal.close(); },
    openDelete(id, name) {
      _deleteId = id;
      window.modal.confirm({
        title: window.__i18n.deleteImageConfirm || "Delete image?",
        body: '"' + name + '" ' + (window.__i18n.willBePermanentlyRemoved || 'will be permanently removed.'),
        danger: true, confirmLabel: window.__i18n.delete || "Delete",
        onConfirm: () => this.deleteImage(),
      });
    },
    async renderImageTable() {
      const res = await fetch("/api/v2/admin/images/list");
      const data = await res.json();
      const tbody = document.getElementById("tableBody");
      if (!data.success) return;
      const emptyState = document.getElementById("installedEmptyState");
      const tableSection = document.getElementById("installedTableSection");
      if (emptyState) emptyState.classList.toggle("hidden", data.images.length > 0);
      if (tableSection) tableSection.classList.toggle("hidden", data.images.length === 0);
      if (!tbody) return;
      const searchInput = document.getElementById("imageFilterInput");
      const q = searchInput ? searchInput.value.toLowerCase().trim() : "";
      tbody.innerHTML = data.images.map(imageRowHtml).join("");
      let n = 0;
      tbody.querySelectorAll(".img-row").forEach(function (r) {
        const match = !q || r.dataset.search.includes(q);
        r.style.display = match ? "" : "none";
        if (match) n++;
      });
      const noResults = document.getElementById("noResults");
      if (noResults) noResults.classList.toggle("hidden", data.images.length === 0 || n > 0 || !q);
      const installedCountEl = document.getElementById("tabCountInstalled");
      if (installedCountEl) installedCountEl.textContent = data.images.length;
      const installedTextEl = document.getElementById("installedImagesCount");
      if (installedTextEl) installedTextEl.textContent = data.images.length;
      if (window.alTableScan) alTableScan(tbody);
    },
    async deleteImage() {
      if (!_deleteId) return;
      const res = await fetch("/api/v2/admin/images/" + _deleteId, { method: "DELETE" });
      if (res.ok) { showToast(window.__i18n.imageDeleted || "Image deleted.", "success"); window.location.reload(); }
      else { showToast(window.__i18n.failed || "Failed.", "error"); }
    },
    openUploadImageModal() {
      setUploadMode("file");
      const modal = document.getElementById("uploadImageModal");
      if (!modal) return;
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add('open');
      document.getElementById("uploadImageModalPanel").classList.add('open');
      this.removeSelectedImageFile();
      const fileInput = document.getElementById("imageFileInput");
      if (fileInput) fileInput.value = "";
    },
    closeUploadImageModal() {
      const modal = document.getElementById("uploadImageModal");
      if (!modal) return;
      modal.classList.remove('open');
      document.getElementById("uploadImageModalPanel").classList.remove('open');
      modal.classList.add("opacity-0", "pointer-events-none");
    },
    removeSelectedImageFile() {
      window.selectedImageFile = null;
      const preview = document.getElementById("imageFilePreview");
      const dropZone = document.getElementById("imageDropZone");
      const btn = document.getElementById("imageUploadButton");
      if (preview) preview.classList.add("hidden");
      if (dropZone) dropZone.classList.remove("hidden");
      if (btn) btn.disabled = true;
    },
    handleImageFileSelection(file) {
      if (!file) return;
      window.selectedImageFile = file;
      document.getElementById("imageSelectedFileName").textContent = file.name;
      document.getElementById("imageSelectedFileSize").textContent = formatImageFileSize(file.size);
      document.getElementById("imageFilePreview").classList.remove("hidden");
      document.getElementById("imageDropZone").classList.add("hidden");
      document.getElementById("imageUploadButton").disabled = false;
    },
    confirmImageUpload() {
      if (!window.selectedImageFile) { showToast(window.__i18n.selectJsonFile || "Select a JSON file to upload.", "error"); return; }
      const file = window.selectedImageFile;
      this.closeUploadImageModal();
      const self = this;
      const r = new FileReader();
      r.onload = function (e) {
        try { JSON.parse(e.target.result); } catch { showToast(window.__i18n.invalidJson || "Invalid JSON.", "error"); return; }
        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/admin/images/upload", true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onload = () => {
          if (xhr.status === 200) { showToast(window.__i18n.imageUploaded || "Image uploaded.", "success"); window.location.reload(); }
          else { showToast(window.__i18n.uploadFailed || "Upload failed.", "error"); }
        };
        xhr.onerror = () => showToast(window.__i18n.uploadFailed || "Upload failed.", "error");
        xhr.send(e.target.result);
      };
      r.readAsText(file);
    },
    submitCreateImage(e) {
      const form = e.target;
      const data = Object.fromEntries(new FormData(form));
      if (!data.name || !data.startup) { showToast(window.__i18n.nameStartupRequired || "Name and startup command are required.", "error"); return; }
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || "";
      fetch("/api/v2/admin/images", {
        method: "POST",
        headers: { "Content-Type": "application/json", "CSRF-Token": csrfToken },
        body: JSON.stringify(data),
      }).then(r => r.json()).then(result => {
        if (result.success !== false) {
          showToast(window.__i18n.imageCreated || "Image created.", "success");
          this.closeCreate();
          window.location.reload();
        } else { showToast(result.error || result.message || (window.__i18n.imageCreateFailed || "Failed to create image."), "error"); }
      }).catch(() => { showToast(window.__i18n.networkError || "Network error.", "error"); });
    }
  };
}

var imageManagerState = imageManager();
document.addEventListener('DOMContentLoaded', function() { imageManagerState.init(); });
</script>

<!-- Store tab JS — same logic as store.ejs, mounted into the tab panel -->
<script nonce="<%- nonce %>">
function imageStore() {
  var _rootStyle = getComputedStyle(document.documentElement);
  var CAT_CLS = { game: "cat-game", application: "cat-application", generic: "cat-generic" };
  var CAT_LABEL = { game: window.__i18n.categoryGame || "Game", application: window.__i18n.categoryApp || "App", generic: window.__i18n.categoryGeneric || "Generic" };
  var CAT_COLOR = {
    game: _rootStyle.getPropertyValue("--theme-accent-purple").trim() || "#7c3aed",
    application: _rootStyle.getPropertyValue("--theme-accent-blue").trim() || "#0284c7",
    generic: _rootStyle.getPropertyValue("--theme-success").trim() || "#16a34a",
  };

  var allImages = [], pendingEgg = null, mdParse = null;
  var searchQuery = "", sortBy = "app", sortDir = "asc";
  var mountedRoot = null, inited = false;

  function esc(s) { return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
  function cap(s) { return s.replace(/[-_]/g," ").replace(/\b\w/g,function(c){return c.toUpperCase();}); }
  function show(id,d) { var e=document.getElementById(id); if(e)e.style.display=d||"block"; }
  function hide(id) { var e=document.getElementById(id); if(e)e.style.display="none"; }
  function catDot(cat,size) { var c=CAT_COLOR[cat]||"#999"; return '<span style="display:inline-block;width:'+(size||8)+'px;height:'+(size||8)+'px;border-radius:50%;background:'+c+';flex-shrink:0"></span>'; }
  function catBadge(cat) { return '<span class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset '+(CAT_CLS[cat]||"")+'">'+catDot(cat,6)+(CAT_LABEL[cat]||cat)+'</span>'; }
  function escHtml(s) { return window.escHtml(s); }

  function groupData() {
    var map = {};
    allImages.forEach(function(img) {
      if (!map[img.group]) map[img.group] = { imgs: [], desc: img.description||"", readme: img.groupReadme||"" };
      map[img.group].imgs.push(img);
      if (img.description && !map[img.group].desc) map[img.group].desc = img.description;
    });
    var q = searchQuery.toLowerCase().trim();
    var out = [];
    Object.keys(map).forEach(function(g) {
      var entry = { group: g, imgs: map[g].imgs, desc: map[g].desc, readme: map[g].readme };
      if (q && !g.toLowerCase().includes(q)) return;
      var counts = {};
      entry.imgs.forEach(function(i) { counts[i.category] = (counts[i.category]||0)+1; });
      entry.domCat = Object.keys(counts).sort(function(a,b){return counts[b]-counts[a];})[0]||"game";
      out.push(entry);
    });
    out.sort(function(a,b) {
      var va, vb;
      if (sortBy==="type") { va=CAT_LABEL[a.domCat]||""; vb=CAT_LABEL[b.domCat]||""; }
      else if (sortBy==="author") { va=a.imgs.length; vb=b.imgs.length; }
      else if (sortBy==="desc") { va=a.desc||""; vb=b.desc||""; }
      else { va=a.group; vb=b.group; }
      if (va<vb) return sortDir==="asc"?-1:1;
      if (va>vb) return sortDir==="asc"?1:-1;
      return 0;
    });
    return out;
  }

  function sortKey(col) {
    if (col===sortBy) sortDir=sortDir==="asc"?"desc":"asc";
    else { sortBy=col; sortDir="asc"; }
    updateSortArrows();
    render();
  }

  function updateSortArrows() {
    var cols = { app:"sortApp", type:"sortType", author:"sortAuthor", desc:"sortDesc" };
    Object.keys(cols).forEach(function(k) {
      var el=document.getElementById(cols[k]);
      if(el) el.textContent = k===sortBy ? (sortDir==="asc"?"\u25B2":"\u25BC") : "";
    });
    document.querySelectorAll("#listEl th").forEach(function(th) {
      var btn=th.querySelector("[data-sort]");
      var col=btn&&btn.getAttribute("data-sort");
      if(!col)return;
      th.setAttribute("aria-sort",col===sortBy?(sortDir==="asc"?"ascending":"descending"):"none");
    });
  }

  async function loadCatalogue() {
    show("loadingEl"); hide("listEl"); hide("errorEl"); hide("emptyEl");
    var st=document.getElementById("statusText"); if(st)st.textContent="";
    try {
      var res=await fetch("/api/v2/admin/images/store/catalogue");
      if(!res.ok) throw new Error(res.status);
      var data=await res.json();
      allImages=data.images||[];
      hide("loadingEl");
      var age=data.builtAt?Math.round((Date.now()-data.builtAt)/60000):0;
      if(st) st.textContent=allImages.length+" " + (window.__i18n.imagesCount || "images") + " \u00B7 "+(age<1?(window.__i18n.fresh || "fresh"):age+(window.__i18n.minutesOld || "m old"));
      updateCount(); render();
    } catch(e) { console.error("Failed to load catalogue:",e); hide("loadingEl"); show("errorEl"); }
  }

  async function doRefresh() {
    document.getElementById("refreshBtnLoad").disabled=true;
    var st=document.getElementById("statusText"); if(st)st.textContent=(window.__i18n.refreshing || "Refreshing")+"\u2026";
    var before=0;
    try { before=(await(await fetch("/api/v2/admin/images/store/catalogue")).json()).builtAt||0; } catch(e) {}
    try {
      var refreshRes=await fetch("/api/v2/admin/images/store/refresh",{method:"POST"});
      if(!refreshRes.ok) throw new Error("Refresh failed");
    } catch(e) {
      document.getElementById("refreshBtnLoad").disabled=false;
      if(st)st.textContent="";
      if(typeof showToast==="function") showToast(window.__i18n.couldNotRefresh || "Could not refresh the catalogue","error");
      return;
    }
    var REFRESH_POLL_INTERVAL_MS = 1000;
    for(var i=0;i<60;i++) {
      await new Promise(function(r){setTimeout(r,REFRESH_POLL_INTERVAL_MS);});
      try { var cur=(await(await fetch("/api/v2/admin/images/store/catalogue")).json()).builtAt||0; if(cur!==before)break; } catch(e) {}
    }
    allImages=[]; show("loadingEl"); hide("listEl"); hide("emptyEl");
    await loadCatalogue();
    document.getElementById("refreshBtnLoad").disabled=false;
  }

  function updateCount() {
    var groups=groupData();
    var el=document.getElementById("countLabel");
    if(el) el.textContent=groups.length+" / "+Object.keys(allImages.reduce(function(m,i){m[i.group]=1;return m;},{})).length;
  }

  function render() {
    var groups=groupData();
    hide("listEl"); hide("emptyEl"); updateCount();
    if(!groups.length) {
      document.getElementById("emptyTxt").textContent=allImages.length?(window.__i18n.noAppsMatchSearch || "No apps match your search."):(window.__i18n.imageCatalogueEmpty || "The image catalogue is empty.");
      show("emptyEl"); return;
    }
    var body=document.getElementById("listBody"); body.innerHTML="";
    groups.forEach(function(g){body.appendChild(makeGroupRow(g));});
    show("listEl");
  }

  function makeGroupRow(g) {
    var tr=document.createElement("tr");
    tr.className="al-table-tr transition-colors cursor-pointer group-hdr-tr";
    tr.innerHTML='<td class="al-table-td whitespace-nowrap py-4 pl-6 pr-3"><div class="flex items-center gap-2.5">'+catDot(g.domCat)+'<span class="text-sm font-medium truncate" style="color:var(--theme-text-strong)">'+esc(cap(g.group))+'</span></div></td><td class="al-table-td whitespace-nowrap px-3 py-4">'+catBadge(g.domCat)+'</td><td class="al-table-td whitespace-nowrap px-3 py-4 text-sm" style="color:var(--theme-text-muted)">'+g.imgs.length+" " + (window.__i18n.image || "image") + (g.imgs.length!==1?(window.__i18n.imagesPlural || "s"):"")+'</td><td class="al-table-td px-3 py-4 text-sm" style="color:var(--theme-text-muted)">'+(g.readme?esc(g.readme.replace(/[#*`\[\]]/g,"")):esc(g.desc||""))+"</td>";
    tr.addEventListener("click",function(){openGroup(g.group,g.imgs);});
    return tr;
  }

  function stageBody(templateId,title,panelClass) {
    var content=document.getElementById("globalModalContent");
    if(content){content.innerHTML="";var tpl=document.getElementById(templateId);if(tpl)content.appendChild(tpl.content.cloneNode(true));}
    window.modal.show({title:title||"",panelClass:panelClass});
  }

  function openGroup(group,imgs) {
    var s=imgs.slice().sort(function(a,b){return a.name.localeCompare(b.name);});
    stageBody("groupTpl",cap(group),"max-w-3xl");
    document.getElementById("grpCount").textContent=s.length+" " + (window.__i18n.image || "image") + (s.length!==1?(window.__i18n.imagesPlural || "s"):"");
    var list=document.getElementById("grpSubList"); list.innerHTML="";
    s.forEach(function(img,i){
      var row=document.createElement("div"); row.className="grp-img-row";
      var subLabel=img.subGroup&&img.subGroup!==img.group?img.subGroup.replace(img.group+"/",""):"";
      row.innerHTML='<div class="flex items-center gap-2 min-w-0">'+catDot(img.category)+'<div class="min-w-0"><p class="text-xs font-medium truncate" style="color:var(--theme-text-strong)">'+esc(img.name)+"</p>"+(subLabel?'<p class="text-[11px] font-mono truncate" style="color:var(--theme-text-muted)">'+esc(subLabel)+"</p>":"")+"</div></div>"+'<button type="button" class="al-btn-secondary px-2 py-1 text-xs font-medium shrink-0">'+(window.__i18n.install || "Install")+'</button>';
      row.style.animationDelay=Math.min(i*20,300)+"ms";
      row.addEventListener("click",function(){openEgg(img);});
      row.querySelector("button").addEventListener("click",function(e){e.stopPropagation();openEgg(img);});
      list.appendChild(row);
    });
    renderMd(imgs[0]?.groupReadme||"",document.getElementById("grpReadme"));
  }

  function closeGroup() { window.modal.close(); }

  async function getMd() {
    if(mdParse) return mdParse;
    try { var mod=await import("<%= assetUrl('/vendor/marked/lib/marked.esm.js') %>"); mdParse=mod.marked; mdParse.setOptions({gfm:true,breaks:true}); }
    catch(e) { mdParse={parse:function(s){return esc(s).replace(/\n/g,"<br>");}}; }
    return mdParse;
  }

  async function renderMd(md,el) {
    el.innerHTML='<p class="text-xs" style="color:var(--theme-text-muted);font-style:italic">' + (window.__i18n.rendering || "Rendering") + '\u2026</p>';
    try { var m=await getMd(); el.innerHTML='<div class="md-body">'+(md?m.parse(md):'<p style="font-style:italic;color:#a3a3a3;font-size:12px;">'+ (window.__i18n.noReadmeAvailable || "No readme available.") + '</p>')+"</div>"; }
    catch(e) { el.innerHTML='<div class="md-body">'+esc(md||"")+"</div>"; }
  }

  function openEgg(img) {
    pendingEgg=img;
    stageBody("eggTpl",img.name,"max-w-lg");
    var catEl=document.getElementById("eggCat");
    catEl.className="text-[10px] font-medium px-2 py-0.5 rounded-full inline-flex items-center gap-1.5 ring-1 ring-inset "+(CAT_CLS[img.category]||"");
    catEl.innerHTML=catDot(img.category,6)+(CAT_LABEL[img.category]||img.category);
    document.getElementById("eggDesc").textContent=img.description||"";
    document.getElementById("eggAuthor").textContent=img.author?(window.__i18n.by || "by ")+" "+img.author:"";
    renderMd(img.fullReadme||img.readme||"",document.getElementById("eggReadme"));
    hide("eggErr");
    var btn=document.getElementById("eggInstallBtn");
    btn.innerHTML=(window.__i18n.install || "Install"); btn.disabled=false; btn.style.background=""; btn.style.borderColor=""; btn.style.pointerEvents="";
  }

  function closeEgg() { window.modal.close(); pendingEgg=null; }

  async function confirmInstall() {
    if(!pendingEgg) return;
    var btn=document.getElementById("eggInstallBtn");
    btn.disabled=true; btn.textContent=(window.__i18n.installing || "Installing")+"\u2026"; hide("eggErr");
    try {
      var res=await fetch("/api/v2/admin/images/store/install",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(pendingEgg.egg)});
      var body=await res.json();
      if(!res.ok){document.getElementById("eggErrTxt").textContent=body.error||(window.__i18n.installationFailed || "Installation failed.");show("eggErr");btn.disabled=false;btn.innerHTML=(window.__i18n.install || "Install");return;}
      var installedName=pendingEgg.name;
      btn.innerHTML='<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> ' + (window.__i18n.installed || "Installed");
      btn.style.background="var(--theme-success, #16a34a)"; btn.style.borderColor="var(--theme-success, #16a34a)"; btn.style.pointerEvents="none";
      if(typeof showToast==="function") showToast('"'+installedName+'" ' + (window.__i18n.installedSuccessfully || "installed successfully."), "success");
      setTimeout(function(){closeEgg();},1500);
    } catch(err) {
      console.error("Image install error:",err);
      document.getElementById("eggErrTxt").textContent=(window.__i18n.installationFailedTryAgain || "Installation failed. Try again.");
      show("eggErr"); btn.disabled=false; btn.innerHTML=(window.__i18n.install || "Install");
    }
  }

  function doSearch(val) { searchQuery=val; render(); }

  function mount(root) {
    if(inited) return; inited=true;
    mountedRoot=root||document;
    var input=mountedRoot.querySelector?mountedRoot.querySelector("#image-store-search-input"):null;
    if(input&&!input._alStoreBound){input._alStoreBound=true;input.addEventListener("input",function(){doSearch(this.value);});}
    if(mountedRoot&&mountedRoot.addEventListener&&!mountedRoot._alStoreSortBound){
      mountedRoot._alStoreSortBound=true;
      mountedRoot.addEventListener("click",function(e){
        var btn=e.target&&e.target.closest?e.target.closest("[data-sort]"):null;
        if(btn&&mountedRoot.contains(btn)){e.preventDefault();sortKey(btn.getAttribute("data-sort"));}
      });
    }
    loadCatalogue();
  }

  function destroy() {
    inited=false; mountedRoot=null; allImages=[]; pendingEgg=null;
    searchQuery=""; sortBy="app"; sortDir="asc";
  }

  return {
    init() {
      window.AdminImageStore = { mount: mount, destroy: destroy, VERSION: 2 };
      window.doSearch = doSearch;
      window.doRefresh = doRefresh;
      window.loadCatalogue = loadCatalogue;
      window.sortKey = sortKey;
      window.confirmInstall = confirmInstall;
      document.addEventListener('al:tabs-change', function(e) {
        var detail = e.detail;
        if (detail && detail.name === 'store') {
          mount(document);
        }
      });
      if (document.getElementById("image-store-search-input")) mount(document);
    }
  };
}

var imageStoreState = imageStore();
document.addEventListener('DOMContentLoaded', function() { imageStoreState.init(); });
</script>

