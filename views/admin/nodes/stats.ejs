<%- include('../../layouts/admin', { title: 'Node Stats' }) %>

<%- include('../../partials/flash-messages') %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <a href="/admin/nodes" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Admin</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/admin/nodes" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Nodes</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);"><%= node.name %></span>
    </li>
  </ol>
</nav>

<div class="al-page-header mb-6">
  <div class="flex items-center gap-3">
    <h1 class="al-page-title"><%= node.name %></h1>
    <% if (node.status === 'Online') { %>
      <span class="al-dot-online"></span>
    <% } else { %>
      <span class="al-dot-offline"></span>
    <% } %>
  </div>
  <p class="al-page-desc"><%= node.address %>:<%= node.port %><% if (node.versionRelease) { %> &middot; <%= node.versionRelease %><% } %></p>
</div>

<div class="flex flex-wrap gap-2 mb-6">
  <a href="/admin/nodes" class="al-btn-secondary">
    <%- icon('arrow-left', { class: 'size-4', strokeWidth: 1.5 }) %> Back
  </a>
  <a href="/admin/node/<%= node.id %>" class="al-btn-secondary">
    <%- icon('pencil', { class: 'size-4', strokeWidth: 1.5 }) %> Edit
  </a>
</div>

<!-- Resource gauges -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">RAM</p>
    <p id="host-ram" class="text-2xl font-semibold" style="color:var(--theme-text-strong)">--</p>
    <p id="host-ram-detail" class="text-xs mt-1" style="color:var(--theme-text-muted)">--</p>
  </div>
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">CPU</p>
    <p id="host-cpu" class="text-2xl font-semibold" style="color:var(--theme-text-strong)">--</p>
    <p id="host-cpu-detail" class="text-xs mt-1" style="color:var(--theme-text-muted)">--</p>
  </div>
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">Disk</p>
    <p id="host-disk" class="text-2xl font-semibold" style="color:var(--theme-text-strong)">--</p>
    <p id="host-disk-detail" class="text-xs mt-1" style="color:var(--theme-text-muted)">--</p>
  </div>
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">Uptime</p>
    <p id="host-uptime" class="text-2xl font-semibold" style="color:var(--theme-text-strong)">--</p>
    <p class="text-xs mt-1" style="color:var(--theme-text-muted)">since boot</p>
  </div>
</div>

<!-- Allocation bars -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="al-card p-4">
    <div class="flex justify-between items-center mb-2">
      <p class="text-sm font-medium" style="color:var(--theme-text-muted);">RAM Allocation</p>
      <p id="alloc-ram-pct" class="text-sm font-medium" style="color:var(--theme-text-muted)">--</p>
    </div>
    <div class="w-full h-2 rounded-full" style="background:var(--theme-bg-secondary)">
      <div id="alloc-ram-bar" class="h-2 rounded-full transition-all duration-500" style="width:0%"></div>
    </div>
    <p id="alloc-ram-text" class="text-xs mt-1.5" style="color:var(--theme-text-muted)">--</p>
  </div>
  <div class="al-card p-4">
    <div class="flex justify-between items-center mb-2">
      <p class="text-sm font-medium" style="color:var(--theme-text-muted);">CPU Allocation</p>
      <p id="alloc-cpu-pct" class="text-sm font-medium" style="color:var(--theme-text-muted)">--</p>
    </div>
    <div class="w-full h-2 rounded-full" style="background:var(--theme-bg-secondary)">
      <div id="alloc-cpu-bar" class="h-2 rounded-full transition-all duration-500" style="width:0%"></div>
    </div>
    <p id="alloc-cpu-text" class="text-xs mt-1.5" style="color:var(--theme-text-muted)">--</p>
  </div>
  <div class="al-card p-4">
    <div class="flex justify-between items-center mb-2">
      <p class="text-sm font-medium" style="color:var(--theme-text-muted);">Disk Allocation</p>
      <p id="alloc-disk-pct" class="text-sm font-medium" style="color:var(--theme-text-muted)">--</p>
    </div>
    <div class="w-full h-2 rounded-full" style="background:var(--theme-bg-secondary)">
      <div id="alloc-disk-bar" class="h-2 rounded-full transition-all duration-500" style="width:0%"></div>
    </div>
    <p id="alloc-disk-text" class="text-xs mt-1.5" style="color:var(--theme-text-muted)">--</p>
  </div>
</div>

<!-- Counts -->
<div class="grid grid-cols-2 gap-4 mb-6">
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">Instances</p>
    <p id="count-instances" class="text-3xl font-semibold" style="color:var(--theme-text-strong)"><%= node._count ? node._count.servers : '--' %></p>
  </div>
  <div class="al-card p-4 text-center">
    <p class="text-sm font-medium mb-1" style="color:var(--theme-text-muted);">Allocations</p>
    <p id="count-alloc" class="text-3xl font-semibold" style="color:var(--theme-text-strong)"><%= node._count ? node._count.allocations : '--' %></p>
  </div>
</div>

<!-- Charts -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="al-card p-6">
    <h2 class="text-sm font-medium mb-4" style="color:var(--theme-text-muted);">RAM Usage</h2>
    <div style="position:relative;height:220px"><canvas id="ramChart"></canvas></div>
  </div>
  <div class="al-card p-6">
    <h2 class="text-sm font-medium mb-4" style="color:var(--theme-text-muted);">CPU Usage</h2>
    <div style="position:relative;height:220px"><canvas id="cpuChart"></canvas></div>
  </div>
</div>

<div id="page-data" style="display:none"
  data-node-id="<%= node.id %>"
  data-stats="<%= JSON.stringify(stats.totalStats || stats || []) %>"
  data-host="<%= JSON.stringify(stats.host || {}) %>"
  data-ram="<%= node.ram || 0 %>"
  data-cpu="<%= node.cpu || 0 %>"
  data-disk="<%= node.disk || 0 %>"
  data-overalloc-mem="<%= node.overallocateMemory || 0 %>"
  data-overalloc-disk="<%= node.overallocateDisk || 0 %>"
  data-overalloc-cpu="<%= node.overallocateCpu || 0 %>"
  data-instances="<%= node._count ? node._count.servers : 0 %>"
  data-allocations="<%= node._count ? node._count.allocations : 0 %>"
></div>

<script nonce="<%- nonce %>" src="<%= assetUrl('/vendor/chart.js/dist/chart.js') %>"></script>
<script nonce="<%- nonce %>">
(function() {
  var pd = document.getElementById('page-data').dataset;
  var hostData = JSON.parse(pd.host || '{}');
  var statsData = JSON.parse(pd.stats || '[]');
  var nodeRam = parseFloat(pd.ram) || 0;
  var nodeCpu = parseFloat(pd.cpu) || 0;
  var nodeDisk = parseFloat(pd.disk) || 0;

  // Populate host info
  if (hostData) {
    if (hostData.ram) document.getElementById('host-ram').textContent = hostData.ram;
    if (hostData.cpu) document.getElementById('host-cpu').textContent = hostData.cpu;
    if (hostData.disk) document.getElementById('host-disk').textContent = hostData.disk;
    if (hostData.uptime) document.getElementById('host-uptime').textContent = hostData.uptime;
    if (hostData.ramDetail) document.getElementById('host-ram-detail').textContent = hostData.ramDetail;
    if (hostData.cpuDetail) document.getElementById('host-cpu-detail').textContent = hostData.cpuDetail;
    if (hostData.diskDetail) document.getElementById('host-disk-detail').textContent = hostData.diskDetail;
  }

  // Charts
  if (typeof Chart !== 'undefined' && statsData.length > 0) {
    var labels = statsData.map(function(s, i) { return i; });
    var ramData = statsData.map(function(s) { return s.memory || 0; });
    var cpuData = statsData.map(function(s) { return s.cpu || 0; });

    var chartOpts = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { display: false },
        y: { beginAtZero: true, max: 100, ticks: { callback: function(v) { return v + '%'; } } }
      },
      elements: { point: { radius: 0 }, line: { tension: 0.4, borderWidth: 2 } }
    };

    new Chart(document.getElementById('ramChart'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{ data: ramData, borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.1)', fill: true }]
      },
      options: chartOpts
    });

    new Chart(document.getElementById('cpuChart'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{ data: cpuData, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true }]
      },
      options: chartOpts
    });
  }
})();
</script>

<%- include('../../layouts/admin-footer') %>
