<%- include('../../layouts/admin', { title: 'Create Node' }) %>

<%- include('../../partials/flash-messages') %>

<nav aria-label="Breadcrumb" class="al-breadcrumb mb-6">
  <ol class="flex items-center text-sm gap-1">
    <li class="flex items-center">
      <a href="/admin/nodes" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Admin</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <a href="/admin/nodes" class="transition-colors hover:underline" style="color:var(--theme-text-muted);">Nodes</a>
    </li>
    <li class="flex items-center">
      <span class="mx-1.5" style="color:var(--theme-text-muted);"><%- icon('chevron-right', { class: 'w-3.5 h-3.5' }) %></span>
      <span style="color:var(--theme-text);">Create</span>
    </li>
  </ol>
</nav>

<div class="al-page-header flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="al-page-title">Create Node</h1>
    <p class="al-page-desc">Add a new node to your infrastructure.</p>
  </div>
  <div class="flex gap-2 shrink-0 items-center">
    <button type="button" onclick="createNode()" class="al-btn-primary" id="createNodeBtn">
      <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> Create Node
    </button>
    <a href="/admin/nodes" class="al-btn-secondary">Back to Nodes</a>
  </div>
</div>

<div id="nodeForm" class="al-page-body space-y-5">
  <form class="space-y-5" onsubmit="event.preventDefault(); createNode();">
    <div class="al-card">
      <h2 class="al-card-header">General</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="md:col-span-2">
          <label for="nodeName" class="al-label flex items-center gap-1.5">
            <%- icon('tag', { width: 14, height: 14, class: 'shrink-0' }) %> Name
          </label>
          <input id="nodeName" class="al-input" placeholder="My node" required>
        </div>
        <div>
          <label for="nodeAddress" class="al-label flex items-center gap-1.5">
            <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %> Address / IP
          </label>
          <input id="nodeAddress" class="al-input" placeholder="localhost" required>
        </div>
        <div>
          <label for="nodePort" class="al-label flex items-center gap-1.5">
            <%- icon('radio-tower', { width: 14, height: 14, class: 'shrink-0' }) %> Daemon Port
          </label>
          <input id="nodePort" class="al-input" placeholder="3001" type="number" min="1" max="65535" required>
        </div>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header">Resource Allocation</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div>
          <label for="nodeRam" class="al-label flex items-center gap-1.5">
            <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %> RAM
          </label>
          <input type="hidden" id="nodeRamValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeRam" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeRam" data-hidden="nodeRamValue"
                data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
            </div>
            <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
              <input type="checkbox" id="nodeRamAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
            </label>
          </div>
        </div>
        <div>
          <label for="nodeDisk" class="al-label flex items-center gap-1.5">
            <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %> Disk
          </label>
          <input type="hidden" id="nodeDiskValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeDisk" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeDisk" data-hidden="nodeDiskValue"
                data-units="1:MB,1024:GB" data-default-unit="GB">GB</button>
            </div>
            <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
              <input type="checkbox" id="nodeDiskAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
            </label>
          </div>
        </div>
        <div>
          <label for="nodeProcessor" class="al-label flex items-center gap-1.5">
            <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %> CPU
          </label>
          <input type="hidden" id="nodeCpuValue" value="">
          <div class="flex gap-2 items-center">
            <div class="flex items-stretch flex-1 gap-0">
              <input id="nodeProcessor" class="al-input rounded-l-xl flex-1 border-r-0" placeholder="Informational only">
              <button type="button" class="al-format-switcher" data-format-switcher
                data-display="nodeProcessor" data-hidden="nodeCpuValue"
                data-units="1:%,100:Cores" data-default-unit="Cores">Cores</button>
            </div>
            <label class="flex items-center gap-1.5 text-xs whitespace-nowrap cursor-pointer shrink-0" style="color:var(--theme-text-muted)">
              <input type="checkbox" id="nodeProcessorAll" class="rounded focus:ring-0" style="border-color:var(--theme-border-input);color:var(--theme-text-strong)"> All
            </label>
          </div>
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">1 core = 100%</p>
        </div>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header">Overallocation</h2>
      <p class="mb-4 text-xs" style="color:var(--theme-text-muted)">Allow nodes to exceed their allocated resources by this percentage.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div>
          <label for="nodeOverallocateMemory" class="al-label flex items-center gap-1.5">
            <%- icon('memory-stick', { width: 14, height: 14, class: 'shrink-0' }) %> Memory %
          </label>
          <input id="nodeOverallocateMemory" type="number" min="0" value="<%= settings.defaultOverallocateMemory || 0 %>" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings</p>
        </div>
        <div>
          <label for="nodeOverallocateDisk" class="al-label flex items-center gap-1.5">
            <%- icon('database', { width: 14, height: 14, class: 'shrink-0' }) %> Disk %
          </label>
          <input id="nodeOverallocateDisk" type="number" min="0" value="<%= settings.defaultOverallocateDisk || 0 %>" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings</p>
        </div>
        <div>
          <label for="nodeOverallocateCpu" class="al-label flex items-center gap-1.5">
            <%- icon('cpu', { width: 14, height: 14, class: 'shrink-0' }) %> CPU %
          </label>
          <input id="nodeOverallocateCpu" type="number" min="0" value="<%= settings.defaultOverallocateCpu || 0 %>" class="al-input">
          <p class="mt-1 text-xs" style="color:var(--theme-text-muted)">Default from global settings</p>
        </div>
      </div>
      <div class="mt-4">
        <label for="nodeLocation" class="al-label flex items-center gap-1.5">
          <%- icon('map-pin', { width: 14, height: 14, class: 'shrink-0' }) %> Location
        </label>
        <select id="nodeLocation" class="al-input">
          <option value="">No location</option>
          <% (locations || []).forEach(function(loc) { %>
          <option value="<%= loc.id %>"><%= loc.name %> (<%= loc.shortCode %>)</option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="al-card">
      <h2 class="al-card-header">Daemon Configuration</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="md:col-span-2">
          <label for="daemonKey" class="al-label">Daemon Key</label>
          <input id="daemonKey" class="al-input" placeholder="Leave blank to auto-generate">
          <p class="mt-1.5 text-xs" style="color:var(--theme-text-muted)">Optional. A secure key will be generated if left blank.</p>
        </div>
        <div class="md:col-span-2">
          <label for="allocatedPorts" class="al-label">Allocated Ports</label>
          <div class="space-y-2">
            <div id="allocatedPortsList" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2"></div>
            <div class="flex gap-2">
              <input id="newPortInput" type="text" placeholder="25565 or 25565-25570" class="al-input flex-1">
              <button id="addPortBtn" type="button" class="al-btn-primary">
                <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %> Add Port
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Post-creation setup panel -->
<div id="nodeSetupPanel" class="hidden">
  <div class="max-w-xl mx-auto">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:color-mix(in srgb, var(--theme-success) 12%, transparent); color:var(--theme-success);">
        <%- icon('check-circle', { class: 'size-8', strokeWidth: 1.5 }) %>
      </div>
      <h2 class="text-xl font-semibold" style="color:var(--theme-text-strong);">Node created — one step left</h2>
      <p class="text-sm mt-2 max-w-md mx-auto" style="color:var(--theme-text-muted);">Run the following command on the daemon machine to connect it to this panel.</p>
    </div>

    <div class="rounded-2xl border p-5" style="border-color:var(--theme-border); background:var(--theme-bg-secondary);">
      <p class="text-xs font-medium mb-3 flex items-center gap-1.5" style="color:var(--theme-text-muted);">
        <%- icon('terminal', { width: 13, height: 13, class: 'shrink-0' }) %> Run on daemon machine
      </p>
      <div class="relative">
        <div id="daemonCliCommand" class="rounded-xl border p-4 pr-12 text-[13px] font-mono whitespace-nowrap overflow-x-auto cursor-text select-all" style="background:var(--theme-bg-input); border-color:var(--theme-border); color:var(--theme-text-strong);" tabindex="0" aria-label="Daemon connect command"></div>
        <button id="copyDaemonCli" type="button" class="absolute top-1/2 -translate-y-1/2 right-2 p-2 rounded-lg transition-colors hover:scale-105" style="color:var(--theme-text-muted);" aria-label="Copy command">
          <%- icon('copy', { class: 'size-4', strokeWidth: 1.5 }) %>
        </button>
      </div>
      <p id="copyDaemonCliHint" class="mt-2 text-xs" style="color:var(--theme-text-muted);"></p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 mt-6">
      <button id="verifyDaemonBtn" type="button" class="al-btn-primary flex-1 justify-center" onclick="verifyDaemon()">
        <%- icon('check', { class: 'size-4', strokeWidth: 1.5 }) %> I've done this — verify
      </button>
      <a href="/admin/nodes" class="al-btn-secondary flex-1 justify-center">Back to Nodes</a>
    </div>
    <p id="daemonVerifyResult" class="hidden mt-4 text-sm font-medium text-center"></p>
  </div>
</div>

<script nonce="<%- nonce %>">
var csrfToken = '<%= csrfToken %>';
var _currentNode = null;
var _currentCli = '';
var allocatedPorts = [];

function renderAllocatedPorts() {
  var portsList = document.getElementById('allocatedPortsList');
  portsList.innerHTML = '';
  if (allocatedPorts.length === 0) {
    var emptyMessage = document.createElement('div');
    emptyMessage.className = 'col-span-4 text-sm italic';
    emptyMessage.style.color = 'var(--theme-text-muted)';
    emptyMessage.textContent = 'No ports allocated yet. Add ports that will be available for servers.';
    portsList.appendChild(emptyMessage);
    return;
  }
  allocatedPorts.forEach(function(port) {
    var portTag = document.createElement('div');
    portTag.className = 'flex items-center justify-between rounded-lg px-3 py-1.5 text-sm';
    portTag.style.background = 'color-mix(in srgb, var(--theme-text) 5%, transparent)';
    portTag.dataset.port = port;
    var portText = document.createElement('span');
    portText.style.color = 'var(--theme-text)';
    portText.textContent = port;
    var deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'ml-2 transition-colors';
    deleteBtn.style.color = 'var(--theme-text-muted)';
    deleteBtn.innerHTML = '<%- icon("x", { class: "w-4 h-4", strokeWidth: 1.5 }) %>';
    deleteBtn.onclick = function(e) {
      e.preventDefault();
      allocatedPorts = allocatedPorts.filter(function(p) { return p !== port; });
      renderAllocatedPorts();
    };
    portTag.appendChild(portText);
    portTag.appendChild(deleteBtn);
    portsList.appendChild(portTag);
  });
}

function addPort(input) {
  if (input.indexOf('-') !== -1) {
    var parts = input.split('-').map(function(p) { return parseInt(p.trim()); });
    var start = parts[0], end = parts[1];
    if (isNaN(start) || isNaN(end) || start >= end || start < 1024 || end > 65535) {
      showToast('Invalid port range. Use format: 25565-25570 (1024-65535).', 'error');
      return;
    }
    for (var port = start; port <= end; port++) {
      if (allocatedPorts.indexOf(port) === -1) allocatedPorts.push(port);
    }
  } else {
    var port = parseInt(input.trim());
    if (isNaN(port) || port < 1024 || port > 65535) {
      showToast('Invalid port. Must be between 1024 and 65535.', 'error');
      return;
    }
    if (allocatedPorts.indexOf(port) === -1) allocatedPorts.push(port);
  }
  allocatedPorts.sort(function(a, b) { return a - b; });
  renderAllocatedPorts();
}

document.getElementById('addPortBtn').addEventListener('click', function() {
  var input = document.getElementById('newPortInput').value.trim();
  if (input) { addPort(input); document.getElementById('newPortInput').value = ''; }
});
document.getElementById('newPortInput').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); var input = this.value.trim(); if (input) { addPort(input); this.value = ''; } }
});

function gbValue(hiddenId) {
  var hidden = document.getElementById(hiddenId);
  if (hidden) {
    var v = parseFloat(hidden.value);
    if (!hidden.value || isNaN(v)) return '';
    return isFinite(v) ? String(Math.round(v / 1024 * 100) / 100) : '';
  }
  return '';
}

function createNode() {
  var ramAll = document.getElementById('nodeRamAll').checked;
  var diskAll = document.getElementById('nodeDiskAll').checked;
  var cpuAll = document.getElementById('nodeProcessorAll').checked;

  var nodeData = {
    name: document.getElementById('nodeName').value,
    ram: ramAll ? 0 : (parseInt(document.getElementById('nodeRamValue').value) || 0),
    cpu: cpuAll ? 0 : (parseInt(document.getElementById('nodeCpuValue').value) || 0),
    disk: diskAll ? 0 : (parseInt(document.getElementById('nodeDiskValue').value) || 0),
    address: document.getElementById('nodeAddress').value,
    port: parseInt(document.getElementById('nodePort').value) || 3001,
    key: document.getElementById('daemonKey').value.trim() || 'auto',
    allocatedPorts: JSON.stringify(allocatedPorts),
    overallocateMemory: parseInt(document.getElementById('nodeOverallocateMemory').value) || 0,
    overallocateDisk: parseInt(document.getElementById('nodeOverallocateDisk').value) || 0,
    overallocateCpu: parseInt(document.getElementById('nodeOverallocateCpu').value) || 0,
    locationId: document.getElementById('nodeLocation').value ? parseInt(document.getElementById('nodeLocation').value) : null
  };

  if (!nodeData.name || !nodeData.address) {
    showToast('Please fill in all required fields.', 'error');
    return;
  }

  var loader = showProgressToast('Initializing node creation...');
  loader.setStage('Sending node configuration...');

  fetch('/admin/nodes/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
    body: JSON.stringify(nodeData)
  })
  .then(function(response) {
    if (response.ok) return response.json();
    return response.json().then(function(d) { throw new Error(d.error || d.message || 'Failed to create node.'); });
  })
  .then(function(data) {
    loader.complete(true, 'Node created!');
    _currentNode = data.node;
    var panelUrl = window.location.origin;
    _currentCli = 'configure --panel "' + panelUrl + '" --key "' + data.node.key + '"';
    document.getElementById('nodeForm').classList.add('hidden');
    document.getElementById('nodeSetupPanel').classList.remove('hidden');
    document.getElementById('daemonCliCommand').textContent = _currentCli;
    document.getElementById('copyDaemonCliHint').textContent = 'Paste into a terminal on the machine where the daemon runs.';
  })
  .catch(function(error) {
    loader.close();
    showToast(error.message || 'Error creating node. Try again.', 'error');
  });
}

document.getElementById('copyDaemonCli').addEventListener('click', function() {
  var btn = this;
  var hint = document.getElementById('copyDaemonCliHint');
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(_currentCli).then(function() {
      hint.textContent = 'Copied!';
      setTimeout(function() { hint.textContent = 'Paste into a terminal on the machine where the daemon runs.'; }, 2000);
    });
  } else {
    var ta = document.createElement('textarea');
    ta.value = _currentCli;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    ta.remove();
    hint.textContent = 'Copied!';
    setTimeout(function() { hint.textContent = 'Paste into a terminal on the machine where the daemon runs.'; }, 2000);
  }
});

function verifyDaemon() {
  var node = _currentNode;
  if (!node) return;
  var btn = document.getElementById('verifyDaemonBtn');
  var result = document.getElementById('daemonVerifyResult');
  btn.disabled = true;
  btn.textContent = 'Checking...';
  result.classList.add('hidden');

  fetch('/admin/node/' + node.id + '/verify', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
  })
  .then(function(res) { return res.json(); })
  .then(function(d) {
    result.classList.remove('hidden');
    if (d.verified) {
      result.style.color = 'var(--theme-success)';
      result.textContent = 'Daemon is live' + (d.version ? ' (' + d.version + ')' : '') + '. Key checks out — servers can now run on this node.';
      showToast('Daemon verified!', 'success');
      setTimeout(function() { window.location.href = '/admin/nodes?verified=' + node.id; }, 1800);
    } else {
      result.style.color = 'var(--theme-danger)';
      result.textContent = d.error || 'Could not reach the daemon. Check the address, port, and key.';
    }
  })
  .catch(function() {
    result.classList.remove('hidden');
    result.style.color = 'var(--theme-danger)';
    result.textContent = 'Verification failed. Check the address, port, and key, then try again.';
  })
  .finally(function() {
    btn.disabled = false;
    btn.textContent = "I've done this — verify connection";
  });
}

// Initialize
renderAllocatedPorts();

// Resource "All" checkboxes
['nodeRam', 'nodeDisk', 'nodeProcessor'].forEach(function(id) {
  var checkbox = document.getElementById(id + 'All');
  var input = document.getElementById(id);
  if (checkbox && input) {
    checkbox.addEventListener('change', function() {
      input.disabled = this.checked;
      if (this.checked) { input.value = ''; input.dispatchEvent(new Event('input')); }
    });
  }
});
</script>

<%- include('../../layouts/admin-footer') %>
