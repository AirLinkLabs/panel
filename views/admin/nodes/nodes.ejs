<%- include('../../components/header', { title: t('adminNodesTitle') }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="hidden lg:block w-60 h-full">
      <%- include('../../components/sidebar') %>
    </div>
<%- include('../../components/template') %>
    <!-- Content -->
    <div id="page-content" class="flex-1 overflow-y-auto pt-0 pb-12">
      <%- include('../../components/ui/breadcrumb', { items: [
        { label: t('admin') },
        { label: t('navNodes') }
      ] }) %>
      <%- include('../../components/ui/page-header', {
        title: t('adminNodesTitle'),
        description: t('adminNodesText'),
        actions: '<a href="#locations" class="al-btn-secondary text-sm">' + icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) + ' ' + t('navLocations') + '</a>' +
                 '<button id="createButton" type="button" class="al-btn-primary" onclick="window.location.href = \'/admin/nodes/create\'">' + icon('plus', { class: 'size-4', strokeWidth: 1.5 }) + t('createNewNode') + '</button>'
      }) %>

      <div class="al-page-body" data-al-tabs data-tabs-default="nodes" data-tabs-hash>

        <div role="tablist" class="flex gap-1 mb-6">
          <button id="tab-btn-nodes" type="button" data-tab="nodes" role="tab" aria-selected="true" tabindex="0" aria-controls="tab-panel-nodes" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('network', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('navNodes') %></button>
          <button id="tab-btn-locations" type="button" data-tab="locations" role="tab" aria-selected="false" tabindex="-1" aria-controls="tab-panel-locations" class="tab-btn px-4 py-2.5 text-sm font-medium transition inline-flex items-center gap-2"><%- icon('map-pin', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('navLocations') %></button>
        </div>

        <div id="tab-panel-nodes" role="tabpanel" aria-labelledby="tab-btn-nodes" data-tab-panel="nodes">

        <div id="stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 mt-6">
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= t('totalNodes') %></h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodesTotal"><%= nodes.length %></p>
            <% if (nodes.length > 0) { %>
            <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= t('onlineNodes') %>: <span id="onlineNodesTotal"><%= nodes.filter(node => node.status === 'Online').length %></span></p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= t('noNodesAvailable') %></p>
            <% } %>
          </div>
          <div class="al-card">
            <h2 class="text-sm font-medium mb-2" style="color:var(--theme-text-muted);"><%= t('servers') %></h2>
            <p class="text-2xl font-semibold tabular-nums" style="color:var(--theme-text-strong);" id="totalNodeInstancesTotal">
              <%= nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0) %>
            </p>
            <% const totalInstances = nodes.reduce((total, node) => total + (node.instances ? node.instances.length : 0), 0); %>
            <% if (totalInstances > 0 && nodes.length > 0) { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);">
                <%= t('averageInstanceDensity') %>:
                <span id="avgNodeInstancesTotal"><%= (totalInstances / nodes.length).toFixed(2) %></span>
              </p>
            <% } else { %>
              <p class="text-xs mt-2" style="color:var(--theme-text-muted);"><%= t('noInstancesAvailable') %></p>
            <% } %>
          </div>
        </div>

        <!-- notifications -->
        <% if (req.query.err == "none") { %>
          <%- include('../../components/ui/alert', { type: 'success', message: t('success') + '!', detail: t('actionCompleted') }) %>
        <% } %>

        <!-- Daemon offline warning -->
        <% if (nodes.some(node => node.status === 'Offline')) { %>
          <div class="al-alert-danger mb-5">
            <%- icon('triangle-alert', { class: 'w-4 h-4 shrink-0 mt-0.5' }) %>
            <div class="flex-1">
              <p class="font-medium"><%= t('connectionError') %></p>
              <p class="text-xs mt-0.5" style="color:var(--theme-text-muted)"><%= t('connectionErrorDesc') %></p>
            </div>
            <button type="button" id="retryConnectionBtn" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">
              <%- icon('refresh-cw', { class: 'size-3', strokeWidth: 1.5 }) %>
              <%= t('retry') %>
            </button>
          </div>
        <% } %>

        <!-- Table of nodes -->
        <%- include('../../fragments/admin/nodes/node-table', { nodes, locations, settings, req }) %>
        </div>

        <!-- Locations Tab -->
        <div id="tab-panel-locations" role="tabpanel" aria-labelledby="tab-btn-locations" data-tab-panel="locations" hidden>
        <div id="locations" class="mt-6 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold tracking-tight" style="color:var(--theme-text-strong);"><%= t('locations') %></h2>
              <p class="text-sm mt-0.5" style="color:var(--theme-text-muted);"><%= t('groupNodesByRegion') %></p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-accent) 12%, transparent); color:var(--theme-accent);">
                <%- icon('map-pin', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="totalLocationsCount"><%= locations.length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);"><%= t('locations') %></p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-info) 12%, transparent); color:var(--theme-info);">
                <%- icon('server', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesAssignedTotal"><%= nodes.filter(n => n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);"><%= t('nodesAssigned') %></p>
              </div>
            </div>
            <div class="al-card p-5 flex items-center gap-4">
              <div class="shrink-0 w-11 h-11 rounded-xl flex items-center justify-center" style="background:color-mix(in srgb, var(--theme-warning) 12%, transparent); color:var(--theme-warning);">
                <%- icon('network', { class: 'size-5' }) %>
              </div>
              <div>
                <p class="text-2xl font-semibold leading-none" style="color:var(--theme-text-strong);" id="nodesUnassignedTotal"><%= nodes.filter(n => !n.locationId).length %></p>
                <p class="text-xs mt-1.5" style="color:var(--theme-text-muted);"><%= t('nodesWithoutLocation') %></p>
              </div>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('createLocation') %></h3>
            <div class="p-5">
              <div id="admin-locations-status"></div>
              <form id="createLocationForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                  <label class="al-label" for="locName"><%= t('name') %></label>
                  <input id="locName" name="name" type="text" placeholder="US East" class="al-input" required>
                </div>
                <div>
                  <label class="al-label" for="locCode"><%= t('shortCode') %></label>
                  <input id="locCode" name="shortCode" type="text" placeholder="us-east" class="al-input" autocapitalize="off" spellcheck="false" required>
                </div>
                <div class="lg:col-span-2 flex items-end">
                  <button type="button" id="submitLocationBtn" class="al-btn-primary w-full sm:w-auto">
                    <%- icon('plus', { class: 'size-4', strokeWidth: 1.5 }) %>
                    <span id="locationBtnLabel"><%= t('createLocation') %></span>
                    <span id="locationBtnSaving" class="hidden"><%= t('creating') %></span>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="al-card">
            <h3 class="al-card-header flex items-center gap-2"><%- icon('map', { class: 'size-4', strokeWidth: 1.5 }) %><%= t('allLocations') %></h3>
            <div class="p-5">
              <%- include('../../fragments/admin/locations/location-list', { locations }) %>
            </div>
          </div>
        </div>
        </div>

      </div>
    </div>
  </div>
</main>


<div id="page-data" style="display:none"></div>
<script nonce="<%- nonce %>">
  document.getElementById('page-data').dataset.nodes = '<%- JSON.stringify(nodes.map(n => ({ id: n.id, status: n.status }))).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\x3c').replace(/>/g, '\\x3e') %>';
</script>
<script nonce="<%- nonce %>">
function handleRowClick(event, url) {
  if (!event.target.closest('button, a')) {
    window.location.href = url;
  }
}

function showConfirmModal(title, message, onConfirm) {
  window.modal.confirm({ title, body: message, danger: true, confirmLabel: window.__i18n.yeahDeleteIt || 'Yeah, delete it', onConfirm });
}

function configure(nodeId) {
  fetch(`/admin/node/${nodeId}/configure`)
    .then(function(response) {
      if (!response.ok)           throw new Error(window.__i18n.failedToFetchConfigCommand || 'Failed to fetch configure command');
      return response.json();
    })
    .then(function(data) {
      var popup = document.createElement('div');
      popup.style.display = 'none';
      popup.innerHTML =
        '<div class="flex justify-center items-center mb-6">' +
          alIcon('badge-check', 'text-emerald-500', { width: 64, height: 64 }) +
        '</div>' +
        '<p class="mb-4 text-neutral-600 dark:text-neutral-300 text-center">' + (window.__i18n.runCommandOnDaemon || 'Run this command on the daemon machine to connect it to this panel:') + '</p>' +
        '<pre class="bg-neutral-100 dark:bg-neutral-900 p-3 rounded-xl mb-4 overflow-x-auto"><code id="commandCode" class="text-emerald-500">' + data + '</code></pre>' +
        '<div class="flex justify-end">' +
          '<button id="copyBtn" class="bg-emerald-600 text-white px-4 py-2 rounded-xl mr-2 hover:bg-emerald-700 transition-colors">' + (window.__i18n.copy || 'Copy') + '</button>' +
          '<button id="doneBtn" class="bg-neutral-800 dark:bg-neutral-700 text-white px-4 py-2 rounded-xl hover:bg-neutral-700 dark:hover:bg-neutral-600 transition-colors">' + (window.__i18n.close || 'Close') + '</button>' +
        '</div>';

      window.modal.show({
        title: window.__i18n.nodeConfigured || 'Node Configured',
        bodyNode: popup,
        panelClass: 'max-w-xl',
      });

      var command = data;
      document.getElementById('copyBtn').addEventListener('click', function() {
        var copyBtn = this;
        navigator.clipboard.writeText(command)
          .then(function() {
            copyBtn.textContent = window.__i18n.copied || 'Copied!';
            copyBtn.classList.replace('bg-emerald-600', 'bg-neutral-600');
            setTimeout(function() {
              copyBtn.textContent = window.__i18n.copy || 'Copy';
              copyBtn.classList.replace('bg-neutral-600', 'bg-emerald-600');
            }, 2000);
          })
          .catch(function(error) { console.error('Failed to copy:', error); showToast(window.__i18n.couldNotCopyCommand || "Couldn't copy the command. Try again.", 'error'); });
      });
      document.getElementById('doneBtn').addEventListener('click', function() { window.modal.close(); });
    })
    .catch(function(error) {
      console.error(error);
      showToast(error.message || (window.__i18n.failedToFetchConfigCommand || 'Failed to fetch configure command.'), 'error');
    });
}

function nodeManager() {
  return {
    init() {
      this.wireNodeStatusRealtime();
    },

    getStatusClass(status) {
      if (status === 'Online') return 'al-dot-online';
      if (status === 'Offline') return 'al-dot-offline';
      return 'al-dot-warning';
    },

    updateNodeStatus(nodeId, status) {
      var cell = document.querySelector('#admin-nodes-table [data-node-id="' + nodeId + '"]');
      if (!cell) return;
      var dot = cell.querySelector('.al-dot-online, .al-dot-offline, .al-dot-warning');
      if (!dot) return;
      var newClass = this.getStatusClass(status);
      if (dot.className !== newClass) {
        dot.className = newClass;
      }
    },

    offlineBannerHtml() {
      return alIcon('triangle-alert', 'w-4 h-4 shrink-0 mt-0.5') +
        '<div class="flex-1">' +
        '<p class="font-medium">' + (window.__i18n.connectionError || 'Connection Error') + '</p>' +
        '<p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">' + (window.__i18n.oneOrMoreNodesOffline || 'One or more nodes are offline. Some information may be unavailable.') + '</p>' +
        '</div>' +
        '<button type="button" onclick="refreshNodeStatuses()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">' +
        alIcon('refresh-cw', 'size-3', { strokeWidth: 1.5 }) + ' ' + (window.__i18n.retryConnection || 'Retry Connection') + '</button>';
    },

    injectOfflineBanner() {
      if (document.querySelector('.al-alert-danger')) return;
      var banner = document.createElement('div');
      banner.className = 'al-alert-danger mb-5';
      banner.innerHTML = this.offlineBannerHtml();
      var table = document.getElementById('admin-nodes-table');
      if (table && table.parentNode) table.parentNode.insertBefore(banner, table);
    },

    applyNodeStatuses(nodes) {
      var self = this;
      nodes.forEach(function (n) {
        self.updateNodeStatus(n.id, n.status);
      });
      var anyOffline = nodes.some(function (n) { return n.status === 'Offline'; });
      var alertEl = document.querySelector('.al-alert-danger');
      if (anyOffline) {
        if (!alertEl) self.injectOfflineBanner();
      } else if (alertEl) {
        alertEl.remove();
      }
    },

    pollNodeStatus() {
      var self = this;
      fetch('/api/v2/admin/nodes/list')
        .then(function(r) { return r.json(); })
        .then(function(nodes) {
          if (!nodes || !nodes.length) return;
          self.applyNodeStatuses(nodes);
        })
        .catch(function() {});
    },

    wireNodeStatusRealtime() {
      var self = this;
      var rt = window.alRealtime;
      if (!rt) return;
      var st = window.alState;
      if (rt.watchAll) rt.watchAll();
      if (st && typeof st.observe === 'function') {
        st.observe('admin:nodes', function() { self.pollNodeStatus(); });
        st.observe('node', function() { self.pollNodeStatus(); });
      }
    }
  };
}

(function() {
  var mgr = nodeManager();
  mgr.init();
  var retryBtn = document.getElementById('retryConnectionBtn');
  if (retryBtn) retryBtn.addEventListener('click', function() { window.refreshNodeStatuses(); });
})();
</script>
<script nonce="<%- nonce %>">
window.refreshNodeStatuses = function () {
  var banner = document.querySelector('.al-alert-danger');
  if (banner) {
    banner.innerHTML = '<div class="flex items-center gap-3">' + alIcon('loader-circle', 'w-4 h-4 animate-spin') + '<p class="font-medium">' + (window.__i18n.reconnecting || 'Reconnecting…') + '</p></div>';
  }
  fetch('/api/v2/admin/nodes/list')
    .then(function(r) { return r.json(); })
    .then(function(nodes) {
      if (!nodes || !nodes.length) return;
      nodes.forEach(function (n) {
        var cell = document.querySelector('#admin-nodes-table [data-node-id="' + n.id + '"]');
        if (!cell) return;
        var dot = cell.querySelector('.al-dot-online, .al-dot-offline, .al-dot-warning');
        if (!dot) return;
        var newClass = n.status === 'Online' ? 'al-dot-online' : n.status === 'Offline' ? 'al-dot-offline' : 'al-dot-warning';
        if (dot.className !== newClass) dot.className = newClass;
      });
      var anyOffline = nodes.some(function (n) { return n.status === 'Offline'; });
      var alertEl = document.querySelector('.al-alert-danger');
      if (anyOffline) {
        if (alertEl) {
          alertEl.innerHTML =
            alIcon('triangle-alert', 'w-4 h-4 shrink-0 mt-0.5') +
            '<div class="flex-1"><p class="font-medium">' + (window.__i18n.connectionError || 'Connection Error') + '</p><p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">' + (window.__i18n.oneOrMoreNodesOffline || 'One or more nodes are offline. Some information may be unavailable.') + '</p></div>' +
            '<button type="button" onclick="refreshNodeStatuses()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">' + alIcon('refresh-cw', 'size-3', { strokeWidth: 1.5 }) + ' ' + (window.__i18n.retryConnection || 'Retry Connection') + '</button>';
        } else {
          var table = document.getElementById('admin-nodes-table');
          if (table && table.parentNode) {
            var b = document.createElement('div');
            b.className = 'al-alert-danger mb-5';
            b.innerHTML =
              alIcon('triangle-alert', 'w-4 h-4 shrink-0 mt-0.5') +
              '<div class="flex-1"><p class="font-medium">' + (window.__i18n.connectionError || 'Connection Error') + '</p><p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">' + (window.__i18n.oneOrMoreNodesOffline || 'One or more nodes are offline. Some information may be unavailable.') + '</p></div>' +
              '<button type="button" onclick="refreshNodeStatuses()" class="shrink-0 px-3 py-1 text-xs rounded-lg transition-colors inline-flex items-center gap-1.5" style="background:var(--theme-danger-bg); color:var(--theme-danger);">' + alIcon('refresh-cw', 'size-3', { strokeWidth: 1.5 }) + ' ' + (window.__i18n.retryConnection || 'Retry Connection') + '</button>';
            table.parentNode.insertBefore(b, table);
          }
        }
      } else if (alertEl) {
        alertEl.remove();
      }
    })
    .catch(function() {});
};

document.getElementById('submitLocationBtn').addEventListener('click', async function() {
  var name = document.getElementById('locName').value.trim();
  var shortCode = document.getElementById('locCode').value.trim();
  if (!name || !shortCode) return;
  var btn = this;
  var label = document.getElementById('locationBtnLabel');
  var saving = document.getElementById('locationBtnSaving');
  btn.disabled = true;
  label.classList.add('hidden');
  saving.classList.remove('hidden');
  try {
    var res = await fetch('/api/v2/admin/locations', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, shortCode: shortCode }),
    });
    var data = await res.json();
    if (res.ok) {
      showToast(window.__i18n.locationCreated || 'Location created.', 'success');
      window.location.reload();
    } else {
      showToast((data.error && data.error.message) || (window.__i18n.failedToCreateLocation || 'Failed to create location.'), 'error');
    }
  } catch (e) { showToast(window.__i18n.failedToCreateLocation || 'Failed to create location.', 'error'); }
  btn.disabled = false;
  label.classList.remove('hidden');
  saving.classList.add('hidden');
});
</script>
<script nonce="<%- nonce %>">
(function () {
  document.addEventListener('al:tabs-change', function (e) {
    if (e.detail && e.detail.name === 'locations') {
      var locEl = document.getElementById('locations');
      if (locEl) locEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  var csrfToken = '<%= csrfToken %>';

  window.openLocationEdit = function(id, name, shortCode) {
    var body = document.createElement('div');
    body.innerHTML =
      '<form id="editLocationForm" class="flex flex-col gap-4">' +
        '<div>' +
          '<label class="al-label" for="editLocName">' + (window.__i18n.name || 'Name') + '</label>'' +
          '<input id="editLocName" name="name" type="text" value="' + name.replace(/"/g, '&quot;') + '" class="al-input" required>' +
        '</div>' +
        '<div>' +
          '<label class="al-label" for="editLocCode">' + (window.__i18n.shortCode || 'Short code') + '</label>'' +
          '<input id="editLocCode" name="shortCode" type="text" value="' + shortCode.replace(/"/g, '&quot;') + '" class="al-input" autocapitalize="off" spellcheck="false" required>' +
        '</div>' +
        '<div class="flex justify-end gap-2 pt-1">' +
          '<button type="button" onclick="window.modal.close()" class="al-btn-secondary px-4 py-2 text-sm font-medium">' + (window.__i18n.cancel || 'Cancel') + '</button>'' +
          '<button type="submit" class="al-btn-primary px-4 py-2 text-sm font-medium">' + (window.__i18n.save || 'Save') + '</button>'' +
        '</div>' +
      '</form>';

    window.modal.show({
      title: window.__i18n.editLocation || 'Edit Location',
      bodyNode: body,
      panelClass: 'max-w-md',
    });

    body.querySelector('form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var nameVal = body.querySelector('#editLocName').value.trim();
      var codeVal = body.querySelector('#editLocCode').value.trim().toLowerCase();
      try {
        var res = await fetch('/api/v2/admin/locations/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
          body: JSON.stringify({ name: nameVal, shortCode: codeVal }),
        });
        var data = await res.json();
        if (res.ok) {
          showToast(window.__i18n.locationUpdated || 'Location updated.', 'success');
          window.modal.close();
          window.location.reload();
        } else {
          showToast(data.message || (window.__i18n.updateFailed || 'Update failed.'), 'error');
        }
      } catch(err) {
        showToast(window.__i18n.updateFailed || 'Update failed.', 'error');
      }
    });
  };

  window.openLocationNodes = function(id, name) {
    var body = document.createElement('div');
    body.innerHTML = '<p class="text-sm" style="color:var(--theme-text-muted);">' + (window.__i18n.loading || 'Loading...') + '</p>';

    window.modal.show({
      title: (window.__i18n.nodesIn || 'Nodes in ') + name,
      bodyNode: body,
      panelClass: 'max-w-lg',
    });

    fetch('/api/v2/admin/nodes/list?locationId=' + id)
      .then(function(r) { return r.json(); })
      .then(function(nodes) {
        if (!nodes || !nodes.length) {
          body.innerHTML = '<p class="text-sm text-center py-4" style="color:var(--theme-text-muted);">' + (window.__i18n.noNodesInLocation || 'No nodes in this location.') + '</p>';
          return;
        }
        var html = '<div class="flex flex-col gap-2">';
        nodes.forEach(function(n) {
          var dotClass = n.status === 'Online' ? 'al-dot-online' : n.status === 'Offline' ? 'al-dot-offline' : 'al-dot-warning';
          html += '<div class="flex items-center gap-3 p-3 rounded-xl" style="background:var(--theme-bg-secondary);">' +
            '<span class="shrink-0 w-2 h-2 rounded-full ' + dotClass + '"></span>' +
            '<span class="text-sm font-medium" style="color:var(--theme-text-strong);">' + (n.name || 'Node ' + n.id) + '</span>' +
            '<span class="ml-auto text-xs" style="color:var(--theme-text-muted);">' + n.status + '</span>' +
          '</div>';
        });
        html += '</div>';
        body.innerHTML = html;
      })
      .catch(function() {
        body.innerHTML = '<p class="text-sm text-center py-4" style="color:var(--theme-danger);">' + (window.__i18n.failedToLoadNodes || 'Failed to load nodes.') + '</p>';
      });
  };
})();
</script>

