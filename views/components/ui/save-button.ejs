<% /* save-button: Universal save button for form pages.
     Locals:
       formId   — form element ID to submit (type="submit" form="...")
       onclick  — JS expression to evaluate on click (for non-form pages)
       label    — optional button text override (default: t('saveChanges'))
       iconName — optional icon name override (default: 'save')
       id       — optional element ID
*/ %>
<%
  // Resolve iconName safely: if caller passed a string use it, else default.
  // Cannot use `locals.icon` because EJS res.locals has `icon` (the function).
  const _btnIcon = (typeof locals.iconName === 'string' && locals.iconName) || 'save';
%>
<button
  type="submit"
  <% if (locals.id) { %>id="<%= id %>"<% } %>
  <% if (locals.formId) { %>form="<%= formId %>"<% } %>
  <% if (locals.onclick) { %>onclick="<%= onclick %>"<% } %>
  class="al-btn-primary"
  data-save-btn
>
  <%- icon(_btnIcon, { class: 'size-4', strokeWidth: 1.5 }) %>
  <span data-save-label><%= locals.label || t('saveChanges') %></span>
</button>
