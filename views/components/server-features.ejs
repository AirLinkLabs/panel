
<!-- EULA Feature -->

<% if (typeof features !== 'undefined' && features && features.includes('eula')) { %>
<script nonce="<%- nonce %>">
  window.modal.confirm({
    title: (window.__i18n && window.__i18n.acceptMinecraftEula) || "Accept Minecraft\'s EULA",
    body: (window.__i18n && window.__i18n.eulaModalBody) || "By clicking Accept you agree to the Mojang End User License Agreement (EULA). The server will not start until you accept.",
    danger: false,
    confirmLabel: (window.__i18n && window.__i18n.acceptEula) || "Accept EULA",
    onConfirm: () => {
      fetch('/api/v2/servers/<%= req.params.id %>/features/eula', { method: 'POST', headers: { 'csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' } })
        .then(() => {})
        .catch(error => {
          console.error('There was an error!', error);
          if (typeof showToast === 'function') {
            showToast((window.__i18n && window.__i18n.couldNotAcceptEula) || "Could not accept the EULA. Please try again.", 'error');
          }
        });
    }
  });
</script>
<% } %>

