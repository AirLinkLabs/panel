<!DOCTYPE html>
<html class="h-full js-loading" lang="<%= (req && req.lang) || 'en' %>">
<%
// Overview and Credits own their backgrounds — never show the panel
// wallpaper there so their existing UX is preserved unchanged.
const wallpaperExcluded = req && req.path && (
  req.path.startsWith('/admin/overview') ||
  req.path.startsWith('/credits')
);
%>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    <title><%= settings.title %> - <%= title %></title>
    <script nonce="<%- nonce %>">
      (function(){
        <% const isLightTheme = settings.theme === 'light' || (settings.theme && settings.theme.includes('light')); %>
        <% if (!isLightTheme) { %>
        document.documentElement.classList.add('dark');
        <% } %>
      })();
    </script>
    <link rel="stylesheet" href="<%= assetUrl('/styles.css') %>?v=8">
    <link rel="stylesheet" href="<%= assetUrl('/styles/layout-animations.css') %>?v=8">
    <link rel="stylesheet" href="<%= assetUrl('/styles/motion.css') %>?v=8">
    <link rel="icon" href="<%= settings.favicon && settings.favicon.startsWith('/') ? assetUrl(settings.favicon) : assetUrl('/favicon.ico') %>" type="image/x-icon">
    <link rel="shortcut icon" href="<%= settings.favicon && settings.favicon.startsWith('/') ? assetUrl(settings.favicon) : assetUrl('/favicon.ico') %>" type="image/x-icon">
    <!-- Default themes — always loaded as base layer -->
    <link rel="stylesheet" href="<%= assetUrl('/themes/default-light.css') %>">
    <link rel="stylesheet" href="<%= assetUrl('/themes/default-dark.css') %>">
    <!-- Selected theme override -->
    <% if (settings.theme && settings.theme !== 'default' && settings.theme !== 'light' && settings.theme !== 'dark') { %>
    <link rel="stylesheet" href="<%= assetUrl(settings.theme) %>" id="theme-css">
    <% } %>
    <link rel="stylesheet" href="<%= assetUrl('/vendor/@fontsource-variable/inter/index.css') %>">
    <% if (Array.isArray(typeof extraStyles !== 'undefined' ? extraStyles : undefined)) { %>
      <% for (const stylesheet of extraStyles) { %>
    <link rel="stylesheet" href="<%= stylesheet %>">
      <% } %>
    <% } %>
    <!-- Session/CSRF support -->
    <script nonce="<%- nonce %>">window.__sessionExpiredMsg = '<%= (req.translations && req.translations.sessionExpired) || "Your session expired. Please sign in again." %>';</script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/csrf.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-icon.js') %>?v=8"></script>

    <!-- Vendor bundles — query-core must load before state.js (no defer) -->
    <script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/vendor/query-core.js') %>"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/vendor/reconnecting-websocket/dist/reconnecting-websocket-iife.min.js') %>"></script>

    <!-- Turbo Drive -->
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/vendor/@hotwired/turbo/dist/turbo.es2017-umd.js') %>"></script>
    <script nonce="<%- nonce %>">
      // Turbo Drive event hooks
      document.addEventListener('turbo:load', function () {
        // Reinitialize Alpine on new content
        if (window.Alpine && typeof Alpine.initTree === 'function') {
          Alpine.initTree(document.body);
        }
        // Dispatch al:navigated for page scripts
        document.dispatchEvent(new CustomEvent('al:navigated', {
          detail: { path: window.location.pathname }
        }));
        // Re-mark sidebar active state
        if (window.markActiveNav) markActiveNav(window.location.pathname);
      });

      document.addEventListener('turbo:render', function () {
        // Initialize Alpine on new content after Turbo renders
        if (window.Alpine && typeof Alpine.initTree === 'function') {
          Alpine.initTree(document.body);
        }
      });
    </script>

    <!-- htmx -->
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/vendor/htmx.org/dist/htmx.min.js') %>?v=2.0.10"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/htmx-bootstrap.js') %>?v=1"></script>

    <!-- Alpine.js -->
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/vendor/alpinejs/dist/cdn.min.js') %>?v=3.16.3"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/alpine-bootstrap.js') %>?v=2"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/auto-save.js') %>?v=1"></script>

    <!-- Shared UI components -->
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/format-switcher.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/animations.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/custom-select.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/page-loader.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/checkbox-anim.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/layout-animations.js') %>?v=8"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-table.js') %>?v=7"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-tabs.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-dialog.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-action.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-field.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/al-state.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/islands.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/shared/data-layer.js') %>?v=1"></script>
    <script nonce="<%- nonce %>" defer src="<%= assetUrl('/javascript/api-client.js') %>?v=1"></script>
    <style>
      @keyframes al-page-loader-sweep {
        from { transform: translateX(-110%); }
        to { transform: translateX(365%); }
      }
      @media (prefers-reduced-motion: reduce) {
        #al-page-loader { animation: none !important; transform: translateX(0) !important; }
      }
    </style>
    <style>
      * { scrollbar-width: thin; scrollbar-color: var(--theme-border) transparent; }
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-thumb { background: var(--theme-border); border-radius: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      html, body { transition: background-color 0.25s ease-in, color 0.25s ease-in; background: var(--theme-bg); color: var(--theme-text); }
      /* Safe area handling for notched devices */
      body { 
        padding-top: env(safe-area-inset-top);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }
      /* Mobile bottom bar spacing */
      @media (max-width: 1023px) {
        #page-content, #server-page-body { padding-bottom: 64px; }
      }
      /* Pre-hide animatable content before JS runs so there's no flash-then-hide jitter */
      .js-loading #page-content > *:not(.mobile-top-bar):not(.mobile-bottom-nav):not(.mobile-more-sheet):not([style*="position: fixed"]),
      .js-loading #server-page-body > * {
        opacity: 0;
        transform: translateY(14px);
      }
    </style>
<% if (process.env.NODE_ENV !== 'production') { %>
    <script src="https://cdn.jsdelivr.net/npm/eruda"></script>
    <script>eruda.init();</script>
<% } %>
    <script nonce="<%- nonce %>">
    (function () {
      var v = '<%= panel.version %>', c = '<%= panel.codename %>';
      console.log(
        '%c  /$$$$$$ /$$         /$$/$$         /$$\n' +
        ' /$$__  $|__/        | $|__/        | $$\n' +
        '| $$   $$/$$ /$$$$$$| $$/$$/$$$$$$$| $$   /$$\n' +
        '| $$$$$$$| $$/$$__  $| $| $| $$__  $| $$  /$$/\n' +
        '| $$__  $| $| $$  __| $| $| $$   $| $$$$$$/\n' +
        '| $$  | $| $| $$     | $| $| $$  | $| $$_  $$\n' +
        '| $$  | $| $| $$     | $| $| $$  | $| $$ \\  $$\n' +
        '|__/  |__|__|__/     |__|__|__/  |__|__/  __/',
        'color:#00d4ff;font-family:monospace;font-size:11px;font-weight:bold'
      );
      console.log(
        '%c  Airlink Panel %cv' + v + ' %c' + c,
        'color:#00d4ff;font-size:14px;font-weight:bold',
        'color:#888;font-size:12px',
        'color:#666;font-size:11px;font-style:italic'
      );
      console.log('%c  Airlinklabs \u00b7 MIT License \u00a9 2025', 'color:#555;font-size:11px');
      console.log(
        '%c  GitHub:%c https://github.com/AirlinkLabs   %cDiscord:%c https://discord.gg/ujXyxwwMHc   %cWeb:%c https://airlinklabs.xyz',
        'color:#00d4ff;font-weight:bold', 'color:#999',
        'color:#00d4ff;font-weight:bold', 'color:#999',
        'color:#00d4ff;font-weight:bold', 'color:#999'
      );
    })();
    </script>
</head>
<body style="font-family: 'Inter Variable';<%= (settings.panelWallpaper && !wallpaperExcluded) ? `--al-wallpaper-image:url('${settings.panelWallpaper}');` : '' %>" class="h-full<%= (settings.panelWallpaper && !wallpaperExcluded) ? ' al-wallpaper' : '' %>">
<% if (settings.panelWallpaper && !wallpaperExcluded) { %>
<!-- Panel wallpaper layer — fixed behind all surfaces. Excluded pages (Overview, Credits) never render this. -->
<div id="al-wallpaper-layer" aria-hidden="true"></div>
<% } %>

<a href="#page-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[99999] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--theme-text-strong)] focus:text-[var(--theme-bg)] focus:text-sm focus:font-medium focus:shadow-lg"><%= t('skipToMainContent') %></a>

<!-- The indeterminate page loading line is created by page-loader.js. -->
<!-- Theme initialization: external module replaces inline script -->
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/shared/theme-init.js') %>?v=1"></script>
<%- include("./bottom-nav") %>
<%- include("./modal") %>
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/shared/toast-store.js') %>?v=1"></script>
<%- include("./toast") %>
<script nonce="<%- nonce %>" src="<%= assetUrl('/javascript/shared/escape.js') %>?v=1"></script>

