<% /* server-card partial — expects `server` with status, node, image, etc. */ %>
<a href="/server/<%= server.UUID %>" class="group al-card hover:border-[var(--theme-border-accent)] transition-colors">
  <div class="flex items-center gap-3">
    <div class="shrink-0">
      <% if (typeof server.status !== 'undefined') { %>
        <% if (server.status === 'running') { %>
          <span class="al-dot-online"></span>
        <% } else if (server.status === 'stopped') { %>
          <span class="al-dot-offline"></span>
        <% } else { %>
          <span class="al-dot-warning"></span>
        <% } %>
      <% } else { %>
        <span class="al-dot-offline"></span>
      <% } %>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-[13px] font-medium truncate" style="color:var(--theme-text-strong)"><%= server.name %></p>
      <% if (server.description) { %>
      <p class="text-[11px] truncate mt-0.5" style="color:var(--theme-text-muted)"><%= server.description %></p>
      <% } %>
    </div>
  </div>

  <div class="mt-3 grid grid-cols-3 gap-2">
    <div>
      <p class="text-[10px] font-medium" style="color:var(--theme-text-muted)"><%= t('cpu') %></p>
      <p class="text-[12px] font-mono" style="color:var(--theme-text)"><%= typeof server.cpuUsage !== 'undefined' ? server.cpuUsage + '%' : '--' %></p>
    </div>
    <div>
      <p class="text-[10px] font-medium" style="color:var(--theme-text-muted)"><%= t('memory') %></p>
      <p class="text-[12px] font-mono" style="color:var(--theme-text)"><%= typeof server.ramUsed !== 'undefined' ? server.ramUsed : '--' %></p>
    </div>
    <div>
      <p class="text-[10px] font-medium" style="color:var(--theme-text-muted)"><%= t('disk') %></p>
      <p class="text-[12px] font-mono" style="color:var(--theme-text)"><%= typeof server.Storage !== 'undefined' ? (server.Storage >= 1024 ? (server.Storage / 1024).toFixed(1) + ' GB' : server.Storage + ' MB') : '--' %></p>
    </div>
  </div>

  <div class="mt-2.5 pt-2.5 flex items-center gap-2 border-t" style="border-color:var(--theme-border)">
    <% if (server.image) { %>
    <span class="text-[10px] px-1.5 py-0.5 rounded-md" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted)"><%= server.image.name %></span>
    <% } %>
    <% if (server.node) { %>
    <span class="text-[10px] px-1.5 py-0.5 rounded-md ml-auto" style="background:var(--theme-bg-secondary); border:1px solid var(--theme-border); color:var(--theme-text-muted)"><%= server.node.name %></span>
    <% } %>
  </div>
</a>
