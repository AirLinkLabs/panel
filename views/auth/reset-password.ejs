<%- include('../layouts/auth', { title: t('resetPassword') }) %>

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] px-4 pt-24 pb-32">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>"
        alt="<%= t('logoAlt') %>"
        class="h-16 w-auto mx-auto mb-6"
        style="background:var(--theme-logo-bg); border-radius: 1.5rem; padding: 0.5rem;">
      <h1 class="text-2xl font-bold" style="color:var(--theme-text-strong);">
        <%= t('resetPasswordTitle') %>
      </h1>
      <p class="text-sm mt-1.5" style="color:var(--theme-text-muted);">
        <%= t('resetPasswordSubtitle') %>
      </p>
    </div>

    <form method="POST" action="/auth/reset-password" class="space-y-4">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

      <%- include('../partials/ui/form-field', {
        type: 'password',
        name: 'password',
        label: t('fieldNewPassword'),
        id: 'reset-password',
        placeholder: t('fieldNewPasswordPlaceholder'),
        required: true,
        autocomplete: 'new-password'
      }) %>

      <%- include('../partials/ui/form-field', {
        type: 'password',
        name: 'passwordConfirm',
        label: t('fieldConfirmPassword'),
        id: 'reset-password-confirm',
        placeholder: t('fieldConfirmPasswordPlaceholder'),
        required: true,
        autocomplete: 'new-password'
      }) %>

      <%- include('../partials/ui/button', {
        type: 'submit',
        label: t('resetPasswordButton'),
        variant: 'primary',
        cls: 'w-full'
      }) %>
    </form>

    <p class="text-center text-sm mt-6" style="color:var(--theme-text-muted);">
      <a href="/auth/login" class="font-medium hover:underline" style="color:var(--theme-primary);">
        <%- icon('arrow-left', { class: 'w-3.5 h-3.5 inline-block mr-1 -mt-0.5' }) %>
        <%= t('backToLogin') %>
      </a>
    </p>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
