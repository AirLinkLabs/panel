<%- include('../layouts/auth', { title: t('login') }) %>

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] px-4 pt-24 pb-32">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>"
        alt="<%= t('logoAlt') %>"
        class="h-16 w-auto mx-auto mb-6"
        style="background:var(--theme-logo-bg); border-radius: 1.5rem; padding: 0.5rem;">
      <h1 class="text-2xl font-bold" style="color:var(--theme-text-strong);">
        <%= t('loginTitle') %>
      </h1>
      <p class="text-sm mt-1.5" style="color:var(--theme-text-muted);">
        <%= t('loginSubtitle') %>
      </p>
    </div>

    <form method="POST" action="/auth/login" class="space-y-4">
      <%- include('../partials/csrf') %>

      <%- include('../partials/ui/form-field', {
        type: 'email',
        name: 'email',
        label: t('fieldEmail'),
        id: 'login-email',
        placeholder: t('fieldEmailPlaceholder'),
        required: true,
        autocomplete: 'email'
      }) %>

      <%- include('../partials/ui/form-field', {
        type: 'password',
        name: 'password',
        label: t('fieldPassword'),
        id: 'login-password',
        placeholder: t('fieldPasswordPlaceholder'),
        required: true,
        autocomplete: 'current-password'
      }) %>

      <div class="flex items-center justify-between">
        <%- include('../partials/ui/form-field', {
          type: 'checkbox',
          name: 'remember',
          id: 'remember',
          label: t('rememberMe'),
          checked: false
        }) %>
        <a href="/auth/forgot-password" class="text-sm hover:underline" style="color:var(--theme-primary);">
          <%= t('forgotPassword') %>
        </a>
      </div>

      <%- include('../partials/ui/button', {
        type: 'submit',
        label: t('login'),
        variant: 'primary',
        cls: 'w-full'
      }) %>
    </form>

    <p class="text-center text-sm mt-6" style="color:var(--theme-text-muted);">
      <%= t('noAccount') %>
      <a href="/auth/register" class="font-medium hover:underline" style="color:var(--theme-primary);">
        <%= t('register') %>
      </a>
    </p>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
