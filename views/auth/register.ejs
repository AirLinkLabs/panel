<%- include('../layouts/auth', { title: t('register') }) %>

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] px-4 pt-24 pb-32">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <img src="<%= settings.logo.startsWith('/') ? settings.logo : '/' + settings.logo %>"
        alt="<%= t('logoAlt') %>"
        class="h-16 w-auto mx-auto mb-6"
        style="background:var(--theme-logo-bg); border-radius: 1.5rem; padding: 0.5rem;">
      <h1 class="text-2xl font-bold" style="color:var(--theme-text-strong);">
        <%= t('registerTitle') %>
      </h1>
      <p class="text-sm mt-1.5" style="color:var(--theme-text-muted);">
        <%= t('registerSubtitle') %>
      </p>
    </div>

    <% if (req.query.err) { %>
    <div class="rounded-xl px-4 py-3 mb-5" style="background:var(--theme-danger-bg);border:1px solid var(--theme-danger)" role="alert" aria-live="assertive">
      <p class="text-sm font-medium" style="color:var(--theme-danger)">
        <% if (req.query.err === 'missing_credentials') { %><%= t('errorAllFieldsRequired') %>
        <% } else if (req.query.err === 'invalid_username') { %><%= t('errorInvalidUsername') %>
        <% } else if (req.query.err === 'user_already_exists') { %><%= t('errorUserAlreadyExists') %>
        <% } else if (req.query.err === 'weak_password') { %><%= t('errorWeakPassword') %>
        <% } else { %><%= t('errorGeneric') %><% } %>
      </p>
    </div>
    <% } %>

    <form method="POST" action="/register" class="space-y-4">
      <%- include('../partials/csrf') %>

      <%- include('../partials/ui/form-field', {
        type: 'text',
        name: 'username',
        label: t('fieldUsername'),
        id: 'register-username',
        placeholder: t('fieldUsernamePlaceholder'),
        required: true,
        autocomplete: 'username'
      }) %>

      <%- include('../partials/ui/form-field', {
        type: 'email',
        name: 'email',
        label: t('fieldEmail'),
        id: 'register-email',
        placeholder: t('fieldEmailPlaceholder'),
        required: true,
        autocomplete: 'email'
      }) %>

      <%- include('../partials/ui/form-field', {
        type: 'password',
        name: 'password',
        label: t('fieldPassword'),
        id: 'register-password',
        placeholder: t('fieldPasswordPlaceholder'),
        required: true,
        autocomplete: 'new-password'
      }) %>

      <%- include('../partials/ui/form-field', {
        type: 'password',
        name: 'passwordConfirm',
        label: t('fieldConfirmPassword'),
        id: 'register-password-confirm',
        placeholder: t('fieldConfirmPasswordPlaceholder'),
        required: true,
        autocomplete: 'new-password'
      }) %>

      <% if (settings.registerEmailConfirmation) { %>
        <div class="rounded-xl p-3 text-sm" style="background:var(--theme-bg-secondary); color:var(--theme-text-muted);">
          <%- icon('mail', { class: 'w-4 h-4 inline-block mr-1.5 -mt-0.5' }) %>
          <%= t('registerEmailNote') %>
        </div>
      <% } %>

      <%- include('../partials/ui/button', {
        type: 'submit',
        label: t('register'),
        variant: 'primary',
        cls: 'w-full'
      }) %>
    </form>

    <p class="text-center text-sm mt-6" style="color:var(--theme-text-muted);">
      <%= t('hasAccount') %>
      <a href="/login" class="font-medium hover:underline" style="color:var(--theme-primary);">
        <%= t('login') %>
      </a>
    </p>
  </div>
</div>

<%- include('../layouts/auth-footer') %>
